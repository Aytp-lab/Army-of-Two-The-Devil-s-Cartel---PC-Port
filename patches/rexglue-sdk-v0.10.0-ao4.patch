+// Lengths from readback_resolve_full_lengths (parsed again when the option text changes).
+bool Ao4ReadbackSyncLength(uint32_t length) {
+  static std::string parsed_text = "\x01";
+  static std::vector<uint32_t> lengths;
+  std::string text = REXCVAR_GET(readback_resolve_full_lengths);
+  // Experiments (AO4_READBACK_POLICY_FILE): the file content replaces the option, re-read every
+  // 2 s, so several policies can be compared in one session at the same spot. "all" = sync all.
+  static const char* policy_file = std::getenv("AO4_READBACK_POLICY_FILE");
+  if (policy_file && *policy_file) {
+    static std::string file_text;
+    static uint64_t next_read = 0;
+    const uint64_t now = GetTickCount64();
+    if (now >= next_read) {
+      next_read = now + 2000;
+      std::ifstream in(policy_file);
+      std::string line;
+      std::getline(in, line);
+      while (!line.empty() && (line.back() == 13 || line.back() == ' ')) line.pop_back();
+      if (line != file_text) REXGPU_WARN("AO4_READBACK_POLICY '{}'", line);
+      file_text = line;
+    }
+    text = file_text == "all" ? std::string() : file_text;
+  }
+  if (text != parsed_text) {
+    parsed_text = text;
+    lengths.clear();
+    size_t start = 0;
+    while (start < text.size()) {
+      const size_t comma = text.find(',', start);
+      const std::string item = text.substr(start, comma == std::string::npos ? std::string::npos : comma - start);
+      if (!item.empty()) lengths.push_back(uint32_t(std::strtoul(item.c_str(), nullptr, 10)));
+      if (comma == std::string::npos) break;
+      start = comma + 1;
+    }
+  }
+  if (lengths.empty()) return true;
+  for (uint32_t l : lengths) if (l == length) return true;
+  return false;
+}
+struct Ao4ReadbackStat { uint32_t count = 0, synced = 0; double wait_ms = 0; };
+std::map<uint64_t, Ao4ReadbackStat> ao4_readback_stats;
+uint64_t ao4_readback_stats_since = 0;
+void Ao4ReadbackStatsTick() {
+  const uint64_t now = GetTickCount64();
+  if (!ao4_readback_stats_since) ao4_readback_stats_since = now;
+  if (now - ao4_readback_stats_since < 5000) return;
+  std::string line;
+  double total_wait = 0;
+  uint32_t total = 0;
+  for (const auto& [key, st] : ao4_readback_stats) {
+    total_wait += st.wait_ms;
+    total += st.count;
+    line += fmt::format(" {:08X}/{}:{}x{}s{:.1f}ms", uint32_t(key >> 32), uint32_t(key), st.count, st.synced,
+                        st.wait_ms);
+  }
+  REXGPU_WARN("AO4_READBACK_STATS 5s resolves={} sync_wait_ms={:.1f}{}", total, total_wait, line);
+  ao4_readback_stats.clear();
+  ao4_readback_stats_since = now;
+}
