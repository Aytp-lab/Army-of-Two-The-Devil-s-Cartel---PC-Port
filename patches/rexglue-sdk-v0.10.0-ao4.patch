+  Ao4MemexportStatsTick(ao4_memexport_pending_.size());
+  return true;
+}
+
+void D3D12CommandProcessor::Ao4ApplyMemexport(Ao4PendingMemexport& pending) {
+  uint64_t total = 0;
+  for (const auto& [address, size] : pending.ranges) {
+    memexport::MaskRange mask;
+    if (!pending.full) memexport::GetMaskRange(address, size, mask);
+    total += uint64_t(size) + (pending.full ? 0 : mask.size);
+  }
+  D3D12_RANGE read_range = {0, SIZE_T(total)};
+  void* mapping = nullptr;
+  if (pending.full && SUCCEEDED(pending.buffer->Map(0, &read_range, &mapping))) {
+    auto* bytes = static_cast<const uint8_t*>(mapping);
+    for (const auto& [address, size] : pending.ranges) {
+      if (uint8_t* destination = memory_->TranslatePhysical(address)) std::memcpy(destination, bytes, size);
+      bytes += size;
+    }
+    D3D12_RANGE written = {0, 0};
+    pending.buffer->Unmap(0, &written);
+  } else if (!pending.full && SUCCEEDED(pending.buffer->Map(0, &read_range, &mapping))) {
+    auto* bytes = static_cast<const uint8_t*>(mapping);
+    for (const auto& [address, size] : pending.ranges) {
+      memexport::MaskRange mask;
+      memexport::GetMaskRange(address, size, mask);
+      memexport::CopyWrittenBytes(static_cast<uint8_t*>(memory_->TranslatePhysical(address)), bytes, bytes + size,
+                                  mask.offset, address, size);
+      bytes += size + mask.size;
+    }
+    D3D12_RANGE written = {0, 0};
+    pending.buffer->Unmap(0, &written);
+  }
+  if (pending.reupload) {
+    for (const auto& [address, size] : pending.ranges) shared_memory_->MemoryInvalidationCallback(address, size, true);
+  }
+  ao4_memexport_free_buffers_.emplace_back(pending.buffer, pending.buffer_size);
+  pending.buffer = nullptr;
+  ++ao4_memexport_stats.applied;
+}
+
+void D3D12CommandProcessor::Ao4ApplyCompletedMemexports(bool wait, int reason) {
+  if (ao4_memexport_pending_.empty()) return;
+  if (wait) {
+    // Only await if something is still outstanding on the GPU.
+    submission_completed_ = std::max(submission_completed_, submission_fence_->GetCompletedValue());
+    if (ao4_memexport_pending_.back().submission > submission_completed_) {
+      LARGE_INTEGER t0, t1, f;
+      Ao4WaitTagScope tag(3);
+      QueryPerformanceCounter(&t0);
+      AwaitAllQueueOperationsCompletion();
+      QueryPerformanceCounter(&t1);
+      QueryPerformanceFrequency(&f);
+      ao4_memexport_stats.wait_ms += double(t1.QuadPart - t0.QuadPart) * 1000.0 / double(f.QuadPart);
+      if (reason >= 0 && reason < 14) ++ao4_memexport_stats.syncs[reason];
+    }
+  } else {
+    submission_completed_ = std::max(submission_completed_, submission_fence_->GetCompletedValue());
+  }
+  while (!ao4_memexport_pending_.empty() && ao4_memexport_pending_.front().submission <= submission_completed_) {
+    if (!wait) ++ao4_memexport_stats.applied_nowait;
+    Ao4ApplyMemexport(ao4_memexport_pending_.front());
+    ao4_memexport_pending_.pop_front();
+  }
+}
+
+void D3D12CommandProcessor::OnGuestVisibleGpuSync(int reason) {
+  if (ao4_memexport_pending_.empty()) return;
+  // Lazy: apply what the GPU has finished, without stalling the command processor; the rest follows
+  // as soon as it completes (draw start, idle polling, memory polls on the range).
+  if (REXCVAR_GET(readback_deferred_lazy)) {
+    // Kick the recorded work to the GPU now (so the data arrives as early as possible), don't wait.
+    if (submission_open_ && ao4_memexport_pending_.back().submission >= submission_current_ &&
+        CanEndSubmissionImmediately()) {
+      EndSubmission(false);
+    }
+    Ao4ApplyCompletedMemexports(false, reason);
+    return;
+  }
+  Ao4ApplyCompletedMemexports(true, reason);
+}
+
+void D3D12CommandProcessor::OnGuestGpuMemoryPoll(uint32_t physical_address) {
+  if (ao4_memexport_pending_.empty()) return;
+  for (const auto& pending : ao4_memexport_pending_) {
+    for (const auto& [address, size] : pending.ranges) {
+      if (physical_address >= address && physical_address < address + uint64_t(size)) {
+        Ao4ApplyCompletedMemexports(true, 3);
+        return;
+      }
+    }
+  }
+}
+
+void D3D12CommandProcessor::Ao4CountUploadHazard(
+    const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges, uint32_t page_size_log2) {
+  // A page re-uploaded from guest memory while GPU-written bytes of it are still pending would lose
+  // them on the GPU side. Measured as practically never happening (the CPU writes other pages of
+  // the export buffers); it cannot be awaited here (mid-draw), so the pages are invalidated again
+  // after the GPU bytes have reached guest memory, and the next user re-uploads them complete.
+  if (ao4_memexport_pending_.empty()) return;
+  for (const auto& [page_first, page_count] : upload_page_ranges) {
+    const uint64_t start = uint64_t(page_first) << page_size_log2;
+    const uint64_t end = start + (uint64_t(page_count) << page_size_log2);
+    for (auto& pending : ao4_memexport_pending_) {
+      for (const auto& [address, size] : pending.ranges) {
+        if (address < end && address + uint64_t(size) > start) {
+          if (!pending.reupload) ++ao4_memexport_stats.syncs[13];
+          pending.reupload = true;
+        }
+      }
+    }
+  }
+}
+
+void D3D12CommandProcessor::Ao4MemexportBeforeCommand() {
+  if (ao4_memexport_pending_.empty()) return;
+  Ao4ApplyCompletedMemexports(false, 0);
+  if (!REXCVAR_GET(readback_memexport_page_sync)) return;
+  for (const auto& pending : ao4_memexport_pending_) {
+    for (const auto& [address, size] : pending.ranges) {
+      if (!shared_memory_->Ao4IsRangeValid(address, size)) {
+        static uint32_t logged = 0;
+        if (REXCVAR_GET(readback_memexport_stats) && logged < 40) {
+          ++logged;
+          REXGPU_WARN("AO4_MEMEXPORT_UPLOAD_SYNC addr={:08X} size={} full={} age={} pending={} frame={}", address, size,
+                      pending.full, submission_current_ - pending.submission, ao4_memexport_pending_.size(),
+                      frame_current_);
         }
+        if (REXCVAR_GET(readback_memexport_hazard_probe)) {
+          ++ao4_memexport_stats.syncs[12];
