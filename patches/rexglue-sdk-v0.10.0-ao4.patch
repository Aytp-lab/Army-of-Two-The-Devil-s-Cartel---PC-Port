 namespace rex::graphics::d3d12 {
 
+// AO4: attribution of host GPU fence waits (CheckSubmissionFence) to their trigger.
+// 0 other, 1 primary buffer end (occlusion), 2 prepare-for-wait (occlusion), 3 memexport,
+// 4 frame open (queue frames), 5 submission open.
+namespace {
+int ao4_wait_tag = 0;
+uint32_t ao4_submissions = 0;
+uint32_t ao4_draws_since_submit = 0;
+double ao4_wait_ms[6] = {};
+uint32_t ao4_wait_count[6] = {};
+struct Ao4WaitTagScope {
+  int previous;
+  explicit Ao4WaitTagScope(int tag) : previous(ao4_wait_tag) { ao4_wait_tag = tag; }
+  ~Ao4WaitTagScope() { ao4_wait_tag = previous; }
+};
+void Ao4AccountWait(LARGE_INTEGER t0) {
+  LARGE_INTEGER t1, f;
+  QueryPerformanceCounter(&t1);
+  QueryPerformanceFrequency(&f);
+  const int tag = ao4_wait_tag >= 0 && ao4_wait_tag < 6 ? ao4_wait_tag : 0;
+  ao4_wait_ms[tag] += double(t1.QuadPart - t0.QuadPart) * 1000.0 / double(f.QuadPart);
+  ++ao4_wait_count[tag];
+}
+}  // namespace
+
+// Opt-in diagnostic capture bounded by guest swaps, rather than UI Presents.
+// Never load RenderDoc or interfere with a capture started by another client.
+static void Ao4GuestCaptureAtSwap(ID3D12Device* device) {
+  static const char* request = std::getenv("AO4_RENDERDOC_GUEST_CAPTURE_REQUEST");
+  // AO4_GUEST_CAPTURE_HOTKEY=1: F11 captures the next guest frame (swap to swap).
+  static const bool hotkey = [] {
+    const char* value = std::getenv("AO4_GUEST_CAPTURE_HOTKEY");
+    return value && *value == '1';
+  }();
+  if ((!request || !*request) && !hotkey) return;
+  static RENDERDOC_API_1_6_0* api = nullptr;
+  if (!api) {
+    HMODULE module = GetModuleHandleW(L"renderdoc.dll");
+    if (!module) return;
+    auto get_api = reinterpret_cast<pRENDERDOC_GetAPI>(GetProcAddress(module, "RENDERDOC_GetAPI"));
+    if (!get_api || !get_api(eRENDERDOC_API_Version_1_6_0, reinterpret_cast<void**>(&api))) return;
+  }
+  static ao4::GuestCaptureSeries series;
+  static const uint32_t requested_frames = [] {
+    const char* value = std::getenv("AO4_GUEST_CAPTURE_FRAMES");
+    return value ? (std::max)(1u, (std::min)(8u, uint32_t(std::atoi(value)))) : 1u;
+  }();
+  const bool was_active = series.active();
+  if (series.owned()) {
+    uint32_t saved = api->EndFrameCapture(device, nullptr);
+    series.finished(saved != 0);
+    REXGPU_INFO("AO4 guest capture ended at swap: saved={}", saved);
+  }
+  static bool hotkey_was_down = false;
+  bool hotkey_pressed = false;
+  if (hotkey) {
+    bool down = (GetAsyncKeyState(VK_F11) & 0x8000) != 0;
+    hotkey_pressed = down && !hotkey_was_down;
+    hotkey_was_down = down;
+  }
+  if (!series.active() && was_active) return;
+  if (series.needs_start()) {
+    if (api->IsFrameCapturing()) { series.started(false); return; }
+  } else if (hotkey_pressed) {
+    if (api->IsFrameCapturing()) return;
+  } else {
+    if (!request || !*request) return;
+    std::ifstream input(request);
+    unsigned long pid = 0;
+    if (!(input >> pid) || pid != GetCurrentProcessId()) return;
+    input.close();
+    if (api->IsFrameCapturing()) return;
+    if (!DeleteFileA(request)) return;
+  }
+  if (!series.active()) series.request(requested_frames);
+  api->StartFrameCapture(device, nullptr);
+  series.started(api->IsFrameCapturing() != 0);
+  if (series.owned()) api->SetCaptureTitle("AO4 guest swap to guest swap");
+  REXGPU_INFO("AO4 guest capture started at swap: active={}", series.owned());
+}
+
+// AO4 diagnostic: compares the frontbuffer a swap presents with the resolve
+// destinations of that frame, to explain frames presented black although the
+// scene was rendered. Logs on changes only (GPU thread only).
+static std::vector<std::pair<uint32_t, uint32_t>> ao4_frame_resolves;
+static void Ao4NoteResolve(uint32_t address, uint32_t length) {
+  if (length && ao4_frame_resolves.size() < 512) {
+    ao4_frame_resolves.emplace_back(address, length);
+  }
+}
+static void Ao4CheckSwap(uint32_t frontbuffer_address, uint32_t fetch_address) {
+  static uint64_t swaps = 0;
+  static uint32_t last_fetch = UINT32_MAX;
+  static int last_covered = -1;
+  ++swaps;
+  bool covered = false;
+  for (const auto& r : ao4_frame_resolves) {
