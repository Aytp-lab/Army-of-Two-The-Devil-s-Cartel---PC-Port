+bool D3D12CommandProcessor::IssueDraw_MemexportReadbackDeferred() {
+  Ao4PendingMemexport pending;
+  uint64_t total = 0;
+  for (const auto& range : memexport_ranges_) {
+    memexport::MaskRange mask;
+    if (!memexport::GetMaskRange(range.base_address_dwords << 2, range.size_bytes, mask)) return false;
+    total += uint64_t(range.size_bytes) + mask.size;
+    pending.ranges.emplace_back(range.base_address_dwords << 2, range.size_bytes);
+  }
+  if (!total) return true;
+  if (total > UINT32_MAX) return false;
+  ++ao4_memexport_stats.draws;
+  pending.buffer = Ao4AcquireReadbackBuffer(uint32_t(total), pending.buffer_size);
+  if (!pending.buffer) {
+    // Fall back to the synchronous path.
+    ++ao4_memexport_stats.sync_draws;
+    return IssueDraw_MemexportReadbackMasked();
+  }
+  shared_memory_->UseAsCopySource();
+  PushTransitionBarrier(memexport_write_mask_, memexport_write_mask_state_, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  memexport_write_mask_state_ = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  SubmitBarriers();
+  uint32_t offset = 0;
+  for (const auto& range : memexport_ranges_) {
+    memexport::MaskRange mask;
+    memexport::GetMaskRange(range.base_address_dwords << 2, range.size_bytes, mask);
+    deferred_command_list_.D3DCopyBufferRegion(pending.buffer, offset, shared_memory_->GetBuffer(),
+                                               range.base_address_dwords << 2, range.size_bytes);
+    offset += range.size_bytes;
+    if (mask.size) deferred_command_list_.D3DCopyBufferRegion(pending.buffer, offset, memexport_write_mask_, mask.offset, mask.size);
+    offset += mask.size;
+  }
+  pending.submission = submission_current_;
+  ao4_memexport_pending_.push_back(std::move(pending));
