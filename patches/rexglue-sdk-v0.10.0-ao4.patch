+u32 NetDll_getsockname_entry(u32 caller, u32 socket_handle, ppc_ptr_t<XSOCKADDR_IN> name,
+                             mapped_u32 namelen) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    XThread::SetLastError(0x2736);  // WSAENOTSOCK
+    return ~0u;
+  }
+  N_XSOCKADDR_IN local;
+  if (!name || XFAILED(socket->GetSockName(&local))) {
+    XThread::SetLastError(0x2726);  // WSAEINVAL
+    return ~0u;
+  }
+  name->sin_family = local.sin_family;
+  name->sin_port = local.sin_port;
+  name->sin_addr = local.sin_addr;
+  std::memset(name->x_sin_zero, 0, sizeof(name->x_sin_zero));
+  if (namelen) *namelen = 16;
+  if (NetTrace()) REXLOG_WARN("AO4_NET getsockname {:08X} -> {}", uint32_t(socket_handle), SockAddrText(name));
+  return 0;
+}
