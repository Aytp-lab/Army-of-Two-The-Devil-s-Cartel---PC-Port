+bool D3D12CommandProcessor::OnIdlePoll() {
+  if (ao4_memexport_pending_.empty() && pending_occlusion_queries_.empty()) return false;
+  // Outstanding work recorded in the still open submission would never complete while idle.
+  if (submission_open_ && CanEndSubmissionImmediately()) EndSubmission(false);
+  CheckSubmissionFence(0);  // non-blocking: updates the completed submission, publishes queries
+  Ao4ApplyCompletedMemexports(false, 10);
+  return !ao4_memexport_pending_.empty() || !pending_occlusion_queries_.empty();
+}
