+const char* const kAo4SyncNames[14] = {"draw",  "interrupt", "swap",  "wait_reg_mem", "reg_to_mem", "mem_write",
+                                       "cond_write", "event_shd", "event_ext", "event_zpd", "idle", "upload", "upload_detect", "upload_real"};
+void Ao4MemexportStatsTick(size_t pending) {
+  if (!REXCVAR_GET(readback_memexport_stats)) return;
+  const ULONGLONG now = GetTickCount64();
+  auto& s = ao4_memexport_stats;
+  if (!s.last) s.last = now;
+  if (now - s.last < 5000) return;
+  std::string reasons;
+  for (int i = 0; i < 14; ++i)
+    if (s.syncs[i]) reasons += fmt::format(" {}={}", kAo4SyncNames[i], s.syncs[i]);
+  REXGPU_WARN("AO4_MEMEXPORT_STATS 5s resolves={} draws={} sync_draws={} applied={} applied_nowait={} wait_ms={:.1f} pending={}{}",
+              s.resolves, s.draws, s.sync_draws, s.applied, s.applied_nowait, s.wait_ms, pending, reasons);
+  static const char* const kWaitNames[6] = {"other", "pb_end_occ", "wait_occ", "memexport", "frame_open", "submission"};
+  std::string waits;
+  for (int i = 0; i < 6; ++i) {
+    if (ao4_wait_count[i]) waits += fmt::format(" {}={}x/{:.0f}ms", kWaitNames[i], ao4_wait_count[i], ao4_wait_ms[i]);
+    ao4_wait_count[i] = 0;
+    ao4_wait_ms[i] = 0;
+  }
+  REXGPU_WARN("AO4_GPU_WAITS 5s submissions={}{}", ao4_submissions, waits);
+  ao4_submissions = 0;
+  s = Ao4MemexportStats{};
+  s.last = now;
+}
