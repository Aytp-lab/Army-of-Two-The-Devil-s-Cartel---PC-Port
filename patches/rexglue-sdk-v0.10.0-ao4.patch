+namespace {
+uint32_t ParseIPv4(const std::string& text) {
+  uint32_t parts[4] = {};
+  char tail = 0;
+  if (text.empty() || std::sscanf(text.c_str(), "%u.%u.%u.%u%c", &parts[0], &parts[1], &parts[2],
+                                  &parts[3], &tail) != 4) {
+    return 0;
+  }
+  for (uint32_t part : parts) {
+    if (part > 255) return 0;
+  }
+  return (parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3];
+}
+}  // namespace
+
+uint32_t UserProfile::xlsp_server() const {
+  return ParseIPv4(REXCVAR_GET(xlsp_server));
+}
+
+uint32_t UserProfile::net_bind_ip() const {
+  return ParseIPv4(REXCVAR_GET(net_bind_ip));
+}
+
+bool UserProfile::online_signin() const {
+  return REXCVAR_GET(online_signin);
+}
+
+uint64_t UserProfile::xuid_for(uint32_t user_index) const {
+  if (user_index == 1) {
+    if (const std::string text = REXCVAR_GET(user2_xuid); !text.empty()) {
+      const uint64_t value = std::strtoull(text.c_str(), nullptr, 16);
+      if (value && value != xuid_ && !(value & 0x00C0000000000000ull)) return value;
+    }
+  }
+  return xuid_ + user_index;
+}
+
+std::string UserProfile::name_for(uint32_t user_index) const {
+  if (!user_index) return name_;
+  if (user_index == 1) {
+    if (const std::string name = REXCVAR_GET(user2_name); !name.empty()) return name.substr(0, 15);
+  }
+  // Gamertags are at most 15 characters.
+  const std::string suffix = " " + std::to_string(user_index + 1);
+  return name_.substr(0, 15 - suffix.size()) + suffix;
+}
