+u32 NetDll_XNetCreateKey_entry(u32 caller, mapped_void xnkid, mapped_void xnkey) {
+  if (!OnlinePeers()) return X_ERROR_FUNCTION_FAILED;
+  if (xnkid) {
+    FillRandom(xnkid.host_address(), 8);
+    static_cast<uint8_t*>(xnkid.host_address())[0] = 0x80;  // XNET_XNKID_ONLINE_PEER
+  }
+  if (xnkey) FillRandom(xnkey.host_address(), 16);
+  return 0;
+}
