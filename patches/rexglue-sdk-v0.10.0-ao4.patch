+struct Record {
+  uint64_t sequence=0,utc_ns=0,decoded=0,written=0;
+  uint32_t generation=0,thread=0;
+  XmaLifeEvent event{};
+};
+struct Slot {std::atomic_flag busy=ATOMIC_FLAG_INIT;Record record;};
+struct State {
+  std::filesystem::path dir,log;
+  std::array<Slot,kCapacity> slots;
+  std::array<std::atomic<uint32_t>,kContexts> generations{};
+  std::array<std::atomic<uint64_t>,kContexts> decoded{},written{};
+  std::atomic<uint64_t> next{0},dropped{0};
+  std::atomic<bool> stopping{false};
+  std::thread writer;
+  uint64_t file_number=0,log_offset=0,log_overflows=0;
+  uint32_t markers=0;
+  std::string log_pending;
+  std::string last_request;
+
+  explicit State(std::filesystem::path directory):dir(std::move(directory)),log(EnvPath("AO4_XMA_LIFETIME_LOG")){
+    std::filesystem::create_directories(dir);
+    writer=std::thread([this]{Run();});
+  }
+  void Add(const XmaLifeEvent& event) noexcept {
+    if(stopping.load(std::memory_order_relaxed))return;
+    const auto sequence=next.fetch_add(1,std::memory_order_relaxed)+1;
+    Slot& slot=slots[(sequence-1)%kCapacity];
+    // Never wait for the snapshot writer or another producer on the decoder path.
+    if(slot.busy.test_and_set(std::memory_order_acquire)){dropped.fetch_add(1);return;}
+    Record rec{};rec.sequence=sequence;rec.utc_ns=UtcNs();rec.event=event;
+#ifdef _WIN32
+    rec.thread=GetCurrentThreadId();
+#endif
+    if(event.id<kContexts){
+      rec.generation=generations[event.id].load(std::memory_order_relaxed);
+      rec.decoded=decoded[event.id].load(std::memory_order_relaxed);
+      rec.written=written[event.id].load(std::memory_order_relaxed);
+    }
+    slot.record=rec;
+    slot.busy.clear(std::memory_order_release);
+  }
+  void Save(const char* reason) {
+    const auto end=next.load(std::memory_order_acquire);
+    const auto first=end>kCapacity?end-kCapacity+1:1;
+    uint64_t missing=0;
+    std::vector<Record> records;records.reserve(kCapacity);
+    for(uint64_t seq=first;seq<=end;++seq){
+      Slot& slot=slots[(seq-1)%kCapacity];
+      if(slot.busy.test_and_set(std::memory_order_acquire)){++missing;continue;}
+      const auto record=slot.record;
+      slot.busy.clear(std::memory_order_release);
+      if(record.sequence!=seq){++missing;continue;}
+      records.push_back(record);
+    }
+    auto path=dir/("xma-life-"+std::to_string(UtcNs())+"-"+std::to_string(++file_number)+"-"+reason+".jsonl");
+    if(std::filesystem::exists(path))return;
+    std::ofstream out(path,std::ios::binary);
+    if(!out)return;
+    out<<"{\"kind\":\"snapshot\",\"reason\":\""<<reason<<"\",\"utc_ns\":"<<UtcNs()
+      <<",\"first_sequence\":"<<first<<",\"last_sequence\":"<<end
+      <<",\"capacity\":"<<kCapacity<<",\"records\":"<<records.size()<<",\"snapshot_missing\":"<<missing
+      <<",\"producer_dropped\":"<<dropped.load()<<",\"log_tail_overflows\":"<<log_overflows<<"}\n";
+    for(const auto& r:records){const auto& e=r.event;
+      out<<"{\"kind\":\""<<Name(e.kind)<<"\",\"sequence\":"<<r.sequence<<",\"utc_ns\":"<<r.utc_ns
+        <<",\"thread\":"<<r.thread<<",\"context\":"<<e.id<<",\"guest\":"<<e.guest
