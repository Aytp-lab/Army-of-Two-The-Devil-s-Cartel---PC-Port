+#pragma once
+// Opt-in observation only. No input buffering, replay, latching or state changes.
+#include <rex/input/input.h>
+#include <rex/logging.h>
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <tuple>
+
+namespace rex::input::ao4_audit {
+inline bool Enabled() {
+  static const bool on=[] {const char* v=std::getenv("AO4_INPUT_TRACE");return v&&v[0]=='1';}();
+  return on;
+}
+inline uint64_t Now() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+    std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+inline bool WeaponEnabled() {
+  static const bool on=[] {const char* v=std::getenv("AO4_WEAPON_ACTION_TRACE");return v&&v[0]=='1';}();
+  return on;
+}
+inline std::atomic<unsigned> weapon_budget{0};
+inline std::atomic<uint16_t> ui_weapon_bits{0};
+inline std::atomic<int> weapon_window_focus{-1};
+inline bool WeaponLogAllowed(){return weapon_budget.fetch_add(1,std::memory_order_relaxed)<2048;}
+inline void WeaponEdges(const char* layer,uint16_t before,uint16_t after,uint64_t (&started)[2],uint64_t now,uint64_t gap,int focus){
+  constexpr uint16_t bits[2]={0x4000,0x8000};
+  for(unsigned i=0;i<2;++i)if((before^after)&bits[i]){
+    bool down=(after&bits[i])!=0;
+    uint64_t held=(!down&&started[i])?now-started[i]:0;
+    started[i]=down?now:0;
+    if(WeaponLogAllowed())REXLOG_WARN("AO4_WEAPON_BUTTON layer={} action={} down={} held_us={} poll_gap_us={} ui_bits={:04X} focus={}",
+      layer,i?"switch":"reload",down,held,gap,ui_weapon_bits.load(std::memory_order_relaxed),focus);
+  }
+}
+inline void WeaponUi(uint16_t after,bool focus){
+  if(!WeaponEnabled())return;
+  weapon_window_focus.store(focus?1:0,std::memory_order_relaxed);
+  const uint16_t before=ui_weapon_bits.exchange(after,std::memory_order_relaxed);
+  thread_local uint64_t started[2]{};
+  WeaponEdges("window",before,after,started,Now(),0,focus);
+}
