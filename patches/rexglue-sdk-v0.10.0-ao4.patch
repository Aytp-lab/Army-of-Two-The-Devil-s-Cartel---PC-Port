diff --git a/src/audio/diagnostic_audio_recorder.h b/src/audio/diagnostic_audio_recorder.h
new file mode 100644
index 0000000..5a89806
--- /dev/null
+++ b/src/audio/diagnostic_audio_recorder.h
@@ -0,0 +1,185 @@
+#pragma once
+// Optional AO4 observation of the samples submitted to SDL, never microphone
+// or other applications. File I/O and measurements run off the audio callback.
+#include <array>
+#include <algorithm>
+#include <cstring>
+#include <cstdint>
+#include <cstdlib>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <memory>
+#include <thread>
+#include <windows.h>
+#include <rex/audio/frame_origin.h>
+
+namespace ao4 {
+class AudioRecorder {
+  struct Block {
+    std::array<float, 2048> samples{};
+    uint32_t frames = 0;
+    uint64_t utc_ms = 0;
+    bool underrun = false;
+    FrameParameters parameters{};
+  };
+  std::array<Block, 512> ring_{};
+  std::atomic<uint64_t> write_{0}, read_{0}, dropped_{0};
+  std::atomic<bool> stopping_{false}, finished_{false};
+  std::thread worker_;
+  std::filesystem::path directory_;
+  uint32_t channels_, rate_, max_seconds_;
+  bool frame_origin_=false;
+  uint64_t ambiguous_zero_frames_=0;
+  uint64_t origin_underrun_blocks_=0;
+  FILE *wave_ = nullptr, *metrics_ = nullptr;
+  uint64_t bytes_ = 0, total_frames_ = 0, chunk_frames_ = 0;
+  uint32_t chunk_ = 0;
+  uint64_t measured_ = 0, bad_ = 0, clipped_ = 0, zeros_ = 0, underrun_frames_ = 0;
+  double squares_ = 0, peak_ = 0;
+  uint64_t metric_utc_ = 0;
+  static uint64_t Now() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+  }
+  void U16(uint16_t n) { std::fwrite(&n, 2, 1, wave_); }
+  void U32(uint32_t n) { std::fwrite(&n, 4, 1, wave_); }
+  void Header() {
+    std::fseek(wave_, 0, SEEK_SET);
+    std::fwrite("RIFF", 4, 1, wave_); U32(uint32_t(bytes_ + 48));
+    std::fwrite("WAVEfmt ", 8, 1, wave_); U32(16); U16(3); U16(uint16_t(channels_));
+    U32(rate_); U32(rate_ * channels_ * 4); U16(uint16_t(channels_ * 4)); U16(32);
+    std::fwrite("fact", 4, 1, wave_); U32(4); U32(uint32_t(chunk_frames_));
+    std::fwrite("data", 4, 1, wave_); U32(uint32_t(bytes_));
+    std::fseek(wave_, 0, SEEK_END); std::fflush(wave_);
+  }
+  bool Open(uint64_t utc) {
+    wchar_t name[64]; swprintf_s(name, L"audio-%04u.wav", chunk_++);
+    wave_ = _wfopen((directory_ / name).c_str(), L"wb");
+    if (!wave_) return false;
+    bytes_ = chunk_frames_ = 0; Header();
+    std::fprintf(metrics_, "{\"kind\":\"chunk\",\"file\":\"audio-%04u.wav\",\"utc_ms\":%llu,"
+        "\"channels\":%u,\"rate\":%u,\"source\":\"%s\"}\n",
+        chunk_ - 1, utc, channels_, rate_,frame_origin_?
+        "frame-origin: guest FL FR FC LF BL BR then actual SDL L R; float32, not speaker layout":
+        "game SDL input, float32"); std::fflush(metrics_); return true;
+  }
+  void FlushMetrics() {
+    if (!measured_) return;
+    std::fprintf(metrics_, "{\"kind\":\"audio\",\"utc_ms\":%llu,\"samples\":%llu,"
+        "\"rms\":%.8g,\"peak\":%.8g,\"nonfinite\":%llu,\"over_full_scale\":%llu,"
+        "\"zero_samples\":%llu,\"underrun_frames\":%llu,\"recorder_dropped_blocks\":%llu}\n",
+        metric_utc_, measured_, std::sqrt(squares_ / measured_), peak_, bad_, clipped_,
+        zeros_, underrun_frames_, dropped_.load()); std::fflush(metrics_);
+    measured_ = bad_ = clipped_ = zeros_ = underrun_frames_ = 0;
+    squares_ = peak_ = 0;
+    if (wave_) Header();
+  }
+  void Run() {
+    metrics_ = _wfopen((directory_ / L"audio.jsonl").c_str(), L"wb");
+    if (!metrics_) { finished_ = true; return; }
+    while (!stopping_ || read_.load() < write_.load()) {
+      const auto r = read_.load(std::memory_order_relaxed);
+      if (r == write_.load(std::memory_order_acquire)) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(10)); continue;
+      }
+      const auto& b = ring_[r % ring_.size()];
+      if (!wave_ && !Open(b.utc_ms)) break;
+      if (!measured_) metric_utc_ = b.utc_ms;
+      if(frame_origin_){
+        if(b.underrun && ++origin_underrun_blocks_<=64){
+          std::fprintf(metrics_,"{\"kind\":\"origin_underrun\",\"frame_offset\":%llu,\"utc_ms\":%llu,\"frames\":%u}\n",total_frames_,b.utc_ms,b.frames);
+          std::fflush(metrics_);
+        }
+        bool source_zero=true,output_zero=true;
+        for(uint32_t i=0;i<b.frames;++i){
+          for(uint32_t ch=0;ch<6;++ch)source_zero &= b.samples[i*8+ch]==0;
+          output_zero &= b.samples[i*8+6]==0 && b.samples[i*8+7]==0;
+        }
+        if(output_zero && !source_zero){
+          ++ambiguous_zero_frames_;
+          // Only ambiguous blocks need parameter records. Bound detail even
+          // when a whole stream is intentionally muted; keep the total too.
+          if(ambiguous_zero_frames_<=64){const auto& p=b.parameters;
+            std::fprintf(metrics_,"{\"kind\":\"nonzero_source_zero_output\",\"frame_offset\":%llu,\"utc_ms\":%llu,\"frames\":%u,\"muted\":%s,\"gain\":%.9g,\"center\":%.9g,\"surround\":%.9g,\"lfe\":%.9g,\"scale\":%.9g}\n",
+              total_frames_,b.utc_ms,b.frames,p.muted?"true":"false",p.gain,p.center,p.surround,p.lfe,p.scale);
+            std::fflush(metrics_);
+          }
+        }
+      }
+      const uint32_t count = b.frames * channels_;
+      const size_t written = std::fwrite(b.samples.data(), sizeof(float), count, wave_);
+      if (written != count) {
+        std::fprintf(metrics_, "{\"kind\":\"error\",\"message\":\"audio disk write failed\"}\n");
+        break;
+      }
+      bytes_ += count * 4; total_frames_ += b.frames; chunk_frames_ += b.frames;
+      if (b.underrun) underrun_frames_ += b.frames;
+      for (uint32_t i = 0; i < count; ++i) {
+        const double v = b.samples[i]; ++measured_;
+        if (!std::isfinite(v)) { ++bad_; continue; }
+        squares_ += v * v; peak_ = (std::max)(peak_, std::abs(v));
+        if (std::abs(v) > 1) ++clipped_;
+        if (v == 0) ++zeros_;
+      }
+      read_.store(r + 1, std::memory_order_release);
+      if (measured_ >= uint64_t(rate_) * channels_) FlushMetrics();
+      if (chunk_frames_ >= uint64_t(rate_) * 10) { Header(); std::fclose(wave_); wave_ = nullptr; }
+      if (total_frames_ >= uint64_t(rate_) * max_seconds_) {
+        std::fprintf(metrics_, "{\"kind\":\"limit\",\"message\":\"recording duration reached\"}\n");
+        break;
+      }
+    }
+    finished_ = true;
+    FlushMetrics();
+    if (wave_) { Header(); std::fclose(wave_); wave_ = nullptr; }
+    std::fprintf(metrics_, "{\"kind\":\"stop\",\"utc_ms\":%llu,\"frames\":%llu,\"recorder_dropped_blocks\":%llu,\"nonzero_source_zero_output_blocks\":%llu}\n",
+        Now(), total_frames_, dropped_.load(),ambiguous_zero_frames_);
+    std::fclose(metrics_); metrics_ = nullptr;
+  }
+ public:
+  AudioRecorder(std::filesystem::path directory, uint32_t channels, uint32_t rate,
+                uint32_t seconds = 600,bool frame_origin=false)
+      : directory_(std::move(directory)), channels_(channels), rate_(rate), max_seconds_(seconds),frame_origin_(frame_origin) {
+    std::filesystem::create_directories(directory_);
+    worker_ = std::thread([this] {
+      try { Run(); }
+      catch (...) {
+        finished_ = true;
+        if (wave_) { Header(); std::fclose(wave_); wave_ = nullptr; }
+        if (metrics_) {
+          std::fprintf(metrics_, "{\"kind\":\"error\",\"message\":\"audio recorder exception\"}\n");
+          std::fclose(metrics_); metrics_ = nullptr;
+        }
+      }
+    });
+  }
+  ~AudioRecorder() { stopping_ = true; if (worker_.joinable()) worker_.join(); }
+  void Push(const float* samples, uint32_t frames, bool underrun,
+            const FrameParameters* parameters=nullptr) noexcept {
+    if (finished_ || stopping_ || !samples || frames > 256 || channels_>8) return;
+    const auto w = write_.load(std::memory_order_relaxed);
+    if (w - read_.load(std::memory_order_acquire) >= ring_.size()) { ++dropped_; return; }
+    auto& block = ring_[w % ring_.size()];
+    std::memcpy(block.samples.data(), samples, size_t(frames) * channels_ * sizeof(float));
+    block.frames = frames; block.utc_ms = Now(); block.underrun = underrun;
+    block.parameters=parameters?*parameters:FrameParameters{};
+    write_.store(w + 1, std::memory_order_release);
+  }
+  static std::unique_ptr<AudioRecorder> FromEnvironment(uint32_t channels, uint32_t rate,bool frame_origin=false) {
+    wchar_t path[32768]{};
+    if (!GetEnvironmentVariableW(L"AO4_AV_CAPTURE_DIR", path, 32768)) return {};
+    wchar_t duration[32]{}; uint32_t seconds = 600;
+    if (GetEnvironmentVariableW(L"AO4_AV_SECONDS", duration, 32))
+      seconds = (std::min)(3600u, (std::max)(1u, uint32_t(_wtoi(duration))));
+    static std::atomic<uint32_t> stream_serial{0};
+    wchar_t stream[96];
+    swprintf_s(stream, L"stream-%llu-%u", Now(), stream_serial.fetch_add(1));
+    // Splash and Main may each construct a driver. Keep both observations.
+    try { return std::make_unique<AudioRecorder>(std::filesystem::path(path) / L"audio" / stream, channels, rate, seconds,frame_origin); }
+    catch (...) { return {}; }
+  }
+};
+}  // namespace ao4
diff --git a/src/audio/render_trace.cpp b/src/audio/render_trace.cpp
new file mode 100644
index 0000000..d1210ad
--- /dev/null
+++ b/src/audio/render_trace.cpp
@@ -0,0 +1,188 @@
+#include <rex/audio/render_trace.h>
+#include <rex/audio/xma/lifetime_trace.h>
+#include <rex/system/function_dispatcher.h>
+#include <rex/system/thread_state.h>
+#include <rex/memory.h>
+#include <rex/logging.h>
+#include <rex/ppc/context.h>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace rex::audio::diagnostic {
+namespace {
+std::atomic<PPCFunc*> original_get{},original_release{},original_process{};
+std::atomic<memory::Memory*> trace_memory{};
+std::mutex install_mutex;
+bool Enabled(){static const bool enabled=[] {const char* p=std::getenv("AO4_AUDIO_DAC_TRACE");return p&&std::strcmp(p,"1")==0;}();return enabled;}
+uint64_t Now(){return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::system_clock::now().time_since_epoch()).count());}
+bool Readable(const void* ptr,size_t count){
+#ifdef _WIN32
+ auto current=reinterpret_cast<uintptr_t>(ptr);const auto end=current+count;
+ if(end<current)return false;
+ while(current<end){MEMORY_BASIC_INFORMATION info{};
+  if(!VirtualQuery(reinterpret_cast<const void*>(current),&info,sizeof(info)) || info.State!=MEM_COMMIT || (info.Protect&(PAGE_GUARD|PAGE_NOACCESS)))return false;
+  const auto next=reinterpret_cast<uintptr_t>(info.BaseAddress)+info.RegionSize;
+  if(next<=current)return false;current=next;
+ }
+ return true;
+#else
+ return false;
+#endif
+}
+uint32_t Read32(const unsigned char* p){return (uint32_t(p[0])<<24)|(uint32_t(p[1])<<16)|(uint32_t(p[2])<<8)|p[3];}
+// R2: hot-path check against the SDK guest page table instead of per-call VirtualQuery
+// (A6 coop: observer cost 1.8ms vs original Process 8us starved the second render client).
+bool GuestReadable(uint32_t address,size_t count){
+ auto* memory=trace_memory.load(std::memory_order_acquire);
+ if(!memory||!address||!count||uint64_t(address)+count-1>UINT32_MAX)return false;
+ const uint32_t last=uint32_t(address+count-1);
+ auto* heap=memory->LookupHeap(address);
+ if(!heap||heap!=memory->LookupHeap(last))return false;
+ return heap->QueryRangeAccess(address,last)!=rex::memory::PageAccess::kNoAccess;
+}
+template<size_t N> bool Words(uint32_t address,std::array<uint32_t,N>& words){
+ auto* memory=trace_memory.load(std::memory_order_acquire);
+ if(!memory||!address)return false;
+ const auto* p=memory->TranslateVirtual<unsigned char*>(address);
+ if(!GuestReadable(address,N*4))return false;
+ for(size_t i=0;i<N;++i)words[i]=Read32(p+4*i);return true;
+}
+struct Probe{uint32_t valid=0,zero=0;uint64_t hash=0;};
+Probe Inspect(uint32_t address,uint32_t bytes){
+ auto* memory=trace_memory.load(std::memory_order_acquire);
+ if(!memory || bytes!=6144 || !address)return {};
+ const auto* p=memory->TranslateVirtual<unsigned char*>(address);
+ if(!GuestReadable(address,bytes))return {};
+ Probe result{1,1,14695981039346656037ull};
+ // Integer operations only: do not alter the host floating-point flags.
+ for(uint32_t i=0;i<bytes;i+=4){const uint32_t v=Read32(p+i);result.zero&=(v&0x7fffffffu)==0;result.hash=(result.hash^v)*1099511628211ull;}
+ return result;
+}
+XmaLifeEvent Event(XmaLifeKind kind,uint32_t object,uint32_t caller){
+ XmaLifeEvent event{};event.kind=kind;event.id=UINT32_MAX;event.render_object=object;event.caller=caller;event.render_begin_ns=Now();return event;
+}
+bool Fields(uint32_t interface_address,XmaLifeEvent& event){
+ const auto* object=trace_memory.load(std::memory_order_acquire)->TranslateVirtual<unsigned char*>(interface_address);
+ if(!GuestReadable(interface_address,100))return false;
+ event.render_buffer=Read32(object+56);event.render_bytes=Read32(object+60);return true;
+}
+void CoreSnapshot(PPCContext& ctx,XmaLifeEvent& event){
+ if(event.caller!=0x83CC6754 && event.caller!=0x83CC6984)return;
+ auto* memory=trace_memory.load(std::memory_order_acquire);
+ const auto* core=memory->TranslateVirtual<unsigned char*>(ctx.r31.u32);
+ if(!GuestReadable(ctx.r31.u32,160))return;
+ event.render_core=ctx.r31.u32;event.render_index=ctx.r29.u32;
+ for(size_t i=0;i<event.render_core_words.size();++i)event.render_core_words[i]=Read32(core+4*i);
+ // Follow only the descriptor selection proven in original sub_83CC68B8.
+ uint32_t index=event.render_index;
+ if(Read32(core+120)){
+  const uint32_t root_ptr=Read32(core+40);
+  const auto* root=memory->TranslateVirtual<unsigned char*>(root_ptr);
+  if(!root_ptr||!GuestReadable(root_ptr,4))return;
+  const uint32_t active_ptr=Read32(root);
+  const auto* active=memory->TranslateVirtual<unsigned char*>(active_ptr);
+  if(!active_ptr||!GuestReadable(active_ptr,68))return;
+  const uint32_t selected=Read32(active+64);if(selected!=UINT32_MAX)index=selected;
+ }
+ const uint32_t info_ptr=Read32(core+112);
+ const auto* info=memory->TranslateVirtual<unsigned char*>(info_ptr);
+ if(!info_ptr||!GuestReadable(info_ptr,60)||index>1024)return;
+ const uint64_t address=uint64_t(Read32(info+56))+uint64_t(index)*12;
+ if(address>UINT32_MAX)return;
+ const auto* descriptor=memory->TranslateVirtual<unsigned char*>(uint32_t(address));
+ if(!GuestReadable(uint32_t(address),12))return;
+ for(size_t i=0;i<3;++i)event.render_descriptor[i]=Read32(descriptor+4*i);
+ // Raw words, not a guessed sample format or buffer length.
+ const uint32_t source=event.render_descriptor[0];
+ const auto* prefix=memory->TranslateVirtual<unsigned char*>(source);
+ if(!source||!GuestReadable(source,64))return;
+ for(size_t i=0;i<16;++i)event.render_input_prefix[i]=Read32(prefix+4*i);
+}
+void GetObserver(PPCContext& ctx,uint8_t* base){
+ auto* original=original_get.load(std::memory_order_acquire);
+ const auto interface_address=ctx.r3.u32;auto event=Event(XmaLifeKind::RenderGet,interface_address-4,uint32_t(ctx.lr));
+ const bool fields=Fields(interface_address,event);
+ (*original)(ctx,base);
+ if(fields){event.render_buffer=ctx.r3.u32;const auto probe=Inspect(event.render_buffer,event.render_bytes);
+  event.render_valid_after=probe.valid;event.render_zero_after=probe.zero;event.render_hash_after=probe.hash;XmaLifeRecord(event);}
+}
+void ReleaseObserver(PPCContext& ctx,uint8_t* base){
+ auto* original=original_release.load(std::memory_order_acquire);
+ const auto interface_address=ctx.r3.u32;auto event=Event(XmaLifeKind::RenderRelease,interface_address-4,uint32_t(ctx.lr));
+ event.render_flags=ctx.r5.u32;
+ const bool fields=Fields(interface_address,event);
+ Probe before{};if(fields)before=Inspect(event.render_buffer,event.render_bytes);
+ if((before.valid && before.zero)||event.render_flags==1)CoreSnapshot(ctx,event);
+ (*original)(ctx,base);
+ if(fields){const auto after=Inspect(event.render_buffer,event.render_bytes);
+  event.render_valid_before=before.valid;event.render_zero_before=before.zero;event.render_hash_before=before.hash;
+  event.render_valid_after=after.valid;event.render_zero_after=after.zero;event.render_hash_after=after.hash;
+  XmaLifeRecord(event);
+ }
+}
+void ProcessObserver(PPCContext& ctx,uint8_t* base){
+ auto* original=original_process.load(std::memory_order_acquire);
+ // Observe only the proven final Core call. Other users keep the exact original call.
+ if(uint32_t(ctx.lr)!=0x83CC6984||ctx.r4.u32!=1||ctx.r6.u32!=1){(*original)(ctx,base);return;}
+ auto event=Event(XmaLifeKind::RenderProcess,0,uint32_t(ctx.lr));
+ event.render_processor=ctx.r3.u32;event.render_enabled=ctx.r8.u32;
+ event.render_input_address=ctx.r5.u32;event.render_output_address=ctx.r7.u32;
+ CoreSnapshot(ctx,event);
+ if(event.render_core)event.render_object=event.render_core_words[32]-4;
+ const bool input=Words(event.render_input_address,event.render_descriptor);
