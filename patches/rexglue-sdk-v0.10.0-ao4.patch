+// XNetQosLookup(cxna, apxna, apxnkid, apxnkey, cina, aina, adwServiceId, cProbes,
+// dwBitsPerSec, dwFlags, hEvent, ppxnqos): every target answers at once with a fast link.
+u32 NetDll_XNetQosLookup_entry(u32 caller, u32 xnaddr_count, u32 xnaddrs, u32 xnkids, u32 xnkeys,
+                               u32 inaddr_count, u32 inaddrs, u32 service_ids, u32 probes,
+                               u32 bits_per_sec, u32 flags, u32 event_handle, mapped_u32 pqos) {
+  if (!OnlinePeers()) return X_ERROR_FUNCTION_FAILED;
+  const uint32_t count = xnaddr_count + inaddr_count;
+  const uint32_t size = sizeof(XNQOS) + std::max<uint32_t>(count, 1) * sizeof(XNQOSINFO);
+  const uint32_t guest = REX_KERNEL_MEMORY()->SystemHeapAlloc(size);
+  auto* qos = REX_KERNEL_MEMORY()->TranslateVirtual<XNQOS*>(guest);
+  std::memset(qos, 0, size);
+  qos->count = count;
+  qos->count_pending = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    auto& info = qos->info[i];
+    info.flags = 0x01 | 0x02;  // XNET_XNQOSINFO_COMPLETE | TARGET_CONTACTED
+    info.probes_xmit = info.probes_recv = std::max<uint32_t>(probes, 1);
+    info.rtt_min_in_msecs = 1;
+    info.rtt_med_in_msecs = 2;
+    info.up_bits_per_sec = info.down_bits_per_sec = 100000000;
+  }
+  if (pqos) *pqos = guest;
+  if (event_handle) {
+    if (auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle)) ev->Set(0, false);
+  }
+  if (NetTrace()) REXLOG_WARN("AO4_NET XNetQosLookup targets={} -> complete", count);
+  return 0;
+}
