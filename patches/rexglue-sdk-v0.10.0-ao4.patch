+// The instance's own address as titles see it (used by XNetGetTitleXnAddr and XSessionCreate).
+void Ao4FillOwnXnAddr(void* out) {
+  auto* addr = static_cast<XNADDR*>(out);
+  const auto* profile = REX_KERNEL_STATE()->user_profile();
+  const uint32_t bind_ip = profile->net_bind_ip();
+  addr->ina.s_addr = htonl(bind_ip ? bind_ip : INADDR_LOOPBACK);
+  addr->inaOnline.s_addr = addr->ina.s_addr;
+  addr->wPortOnline = 3074;
+  // Unique per profile: titles (RakNet-style) derive peer identities from the MAC address.
+  const uint64_t xuid = profile->xuid();
+  for (int i = 0; i < 6; ++i) addr->abEnet[i] = uint8_t(xuid >> (8 * i));
+  std::memset(addr->abOnline, 0, sizeof(addr->abOnline));
+  std::memcpy(addr->abOnline, &xuid, sizeof(xuid));
+  RememberXnAddr(*addr);
+}
