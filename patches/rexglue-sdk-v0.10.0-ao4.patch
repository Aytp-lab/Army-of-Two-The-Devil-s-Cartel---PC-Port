+  uint32_t WriteItems(uint32_t buffer_ptr, uint8_t* buffer_data, uint32_t* written_count) override {
+    if (!filled_) {
+      filled_ = true;
+      const uint8_t* extra = memory()->TranslateVirtual(guest_object() + sizeof(X_KENUMERATOR));
+      std::string filter, dump;
+      for (uint32_t i = 0; i < extra_size_; ++i) {
+        const uint8_t c = extra[i];
