diff --git a/include/rex/input/mnk/direct_mouse_queue.h b/include/rex/input/mnk/direct_mouse_queue.h
new file mode 100644
index 0000000..27064af
--- /dev/null
+++ b/include/rex/input/mnk/direct_mouse_queue.h
@@ -0,0 +1,55 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+
+namespace rex::input::mnk {
+// A short lease separates raw mouse events from controller events. Each event
+// takes exactly one route. A missed lease drops old raw data, never replays it
+// as stick input. Controller/keyboard stick state does not enter this queue.
+class DirectMouseQueue {
+ public:
+  void SetEligible(bool eligible) {
+    std::lock_guard lock(mutex_);
+    eligible_ = eligible;
+    if (!eligible) ResetLocked();
+  }
+  void Reset() {
+    std::lock_guard lock(mutex_);
+    ResetLocked();
+  }
+  bool Route(float dx, float dy, uint64_t now) {
+    std::lock_guard lock(mutex_);
+    if (!ActiveLocked(now)) { ResetLocked(); return false; }
+    if (std::isfinite(dx) && std::isfinite(dy)) {
+      dx_ += dx;
+      dy_ += dy;
+      // An implausible backlog is discarded rather than causing a snap.
+      if (!std::isfinite(dx_) || !std::isfinite(dy_) ||
+          std::abs(dx_) > 16384 || std::abs(dy_) > 16384) dx_ = dy_ = 0;
+    }
+    return true;
+  }
+  bool Consume(uint32_t owner, uint64_t now, float& dx, float& dy) {
+    std::lock_guard lock(mutex_);
+    dx = dy = 0;
+    if (!eligible_ || !owner) { ResetLocked(); return false; }
+    if (!ActiveLocked(now) || owner_ != owner) ResetLocked();
+    owner_ = owner;
+    deadline_ = now + 100;
+    dx = dx_; dy = dy_;
+    dx_ = dy_ = 0;
+    return true;
+  }
+ private:
+  bool ActiveLocked(uint64_t now) const {
+    return eligible_ && owner_ && now < deadline_;
+  }
+  void ResetLocked() { owner_ = 0; deadline_ = 0; dx_ = dy_ = 0; }
+  std::mutex mutex_;
+  bool eligible_ = false;
+  uint32_t owner_ = 0;
+  uint64_t deadline_ = 0;
+  float dx_ = 0, dy_ = 0;
+};
+}  // namespace rex::input::mnk
