+template<size_t N> bool ObserveWords(uint32_t address,std::array<uint32_t,N>& words){
+  auto* memory=REX_KERNEL_MEMORY();
+  if(!address||uint64_t(address)+N*4-1>UINT32_MAX)return false;
+  auto* heap=memory->LookupHeap(address);
+  const uint32_t end=address+uint32_t(N*4)-1;
+  if(!heap||heap!=memory->LookupHeap(end)||heap->QueryRangeAccess(address,end)==memory::PageAccess::kNoAccess)return false;
+  const auto* p=memory->TranslateVirtual<const uint8_t*>(address);
+  for(size_t i=0;i<N;++i)words[i]=(uint32_t(p[4*i])<<24)|(uint32_t(p[4*i+1])<<16)|(uint32_t(p[4*i+2])<<8)|p[4*i+3];
+  return true;
+}
+audio::diagnostic::XmaLifeEvent ObserveApi(audio::diagnostic::XmaLifeKind kind,uint32_t guest,
+                                        const audio::XMA_CONTEXT_DATA& data){
+  const auto decoder=static_cast<audio::AudioSystem*>(REX_KERNEL_STATE()->emulator()->audio_system())->xma_decoder();
+  const uint32_t physical=REX_KERNEL_MEMORY()->GetPhysicalAddress(guest);
+  const uint32_t first=decoder->context_array_ptr();
+  const uint32_t id=physical>=first&&physical-first<320*64?(physical-first)/64:UINT32_MAX;
+  return audio::diagnostic::XmaLifeSnapshot(kind,id,guest,data);
+}
+void ObserveInput(audio::diagnostic::XmaLifeKind kind,uint32_t guest,
+                  const audio::XMA_CONTEXT_DATA& data,uint32_t buffer=0){
+  if(!audio::diagnostic::XmaLifeEnabled())return;
+  using K=audio::diagnostic::XmaLifeKind;
+  auto event=ObserveApi(kind,guest,data);
+  const uint32_t slot=kind==K::InputBuffer1||kind==K::InputValid1?1:0;
+  if(event.id<320){
+    if(buffer)observed_input_addresses[event.id][slot].store(buffer,std::memory_order_relaxed);
+    else buffer=observed_input_addresses[event.id][slot].load(std::memory_order_relaxed);
+  }
+  event.api_buffer=buffer;event.api_index=slot;
+  if(ObserveWords(buffer,event.api_input_prefix))event.api_words_valid|=4;
+  const uint32_t packets=slot?data.input_buffer_1_packet_count:data.input_buffer_0_packet_count;
+  // The original AO4 feeder submits single2KiB packets. Copy owned bytes now,
+  // never dereference these addresses later on the writer or analyst thread.
+  if(packets==1&&ObserveWords(buffer,event.api_packet_words))event.api_words_valid|=8;
+  static const bool sample_trace=[] {const char* p=std::getenv("AO4_AUDIO_SAMPLE_TRACE");return p&&p[0]=='1';}();
+  if(sample_trace&&(kind==K::InputValid0||kind==K::InputValid1)){
