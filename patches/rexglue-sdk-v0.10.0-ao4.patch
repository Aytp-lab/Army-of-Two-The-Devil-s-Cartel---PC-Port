diff --git a/include/rex/input/mnk/stick_pulse_queue.h b/include/rex/input/mnk/stick_pulse_queue.h
new file mode 100644
index 0000000..c642fba
--- /dev/null
+++ b/include/rex/input/mnk/stick_pulse_queue.h
@@ -0,0 +1,52 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+
+namespace rex::input::mnk {
+// Turret test: each accumulated mouse impulse is drained by ONE input poll.
+// A timed persistent override is unsuitable for mouse deltas: repeated polls
+// replay it, while intervening zero writes can erase an undelivered impulse.
+class StickPulseQueue {
+ public:
+  void SetEligible(bool value) {
+    std::lock_guard lock(mutex_);
+    eligible_ = value;
+    if (!value) ClearLocked();
+  }
+  void Clear() { std::lock_guard lock(mutex_); ClearLocked(); }
+  bool Push(float x, float y, uint64_t now) {
+    std::lock_guard lock(mutex_);
+    if (!eligible_ || !std::isfinite(x) || !std::isfinite(y)) return false;
+    // Explicit reset is distinct from an idle producer, which must not erase
+    // a pulse before the input poll has consumed it.
+    if ((x == 0 && y == 0) || now >= deadline_) ClearLocked();
+    if (x == 0 && y == 0) return true;
+    x_ += x;
+    y_ += y;
+    if (!std::isfinite(x_) || !std::isfinite(y_)) { ClearLocked(); return false; }
+    // Bound implausible accumulation without changing the vector's direction.
+    const float divisor = std::max({1.0f, std::abs(x_) / 16384, std::abs(y_) / 16384});
+    x_ /= divisor;
+    y_ /= divisor;
+    deadline_ = now + 100;
+    return true;
+  }
+  void Take(uint64_t now, float& x, float& y) {
+    std::lock_guard lock(mutex_);
+    x = y = 0;
+    if (eligible_ && now < deadline_) {
+      const float divisor = std::max({1.0f, std::abs(x_), std::abs(y_)});
+      x = x_ / divisor; y = y_ / divisor;
+    }
+    ClearLocked();
+  }
+ private:
+  void ClearLocked() { x_ = y_ = 0; deadline_ = 0; }
+  std::mutex mutex_;
+  bool eligible_ = false;
+  float x_ = 0, y_ = 0;
+  uint64_t deadline_ = 0;
+};
+}  // namespace rex::input::mnk
diff --git a/include/rex/system/ao4_net_trace.h b/include/rex/system/ao4_net_trace.h
new file mode 100644
index 0000000..6ad1bd6
--- /dev/null
+++ b/include/rex/system/ao4_net_trace.h
@@ -0,0 +1,38 @@
+// AO4 online coop S2: observation-only network/Live probe (env AO4_NET_TRACE=1).
+// Logs socket, XNet, sign-in/privilege and XAM app messages; never changes results.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+#include <fmt/format.h>
+
+namespace rex::system::ao4 {
+
+inline bool NetTrace() {
+  static const bool on = [] {
+    const char* value = std::getenv("AO4_NET_TRACE");
+    return value && *value && *value != '0';
+  }();
+  return on;
+}
+
+// Bounded logging for high-frequency calls: at most `limit` lines per key.
+inline bool NetTraceBudget(const std::string& key, uint32_t limit) {
+  static std::mutex mutex;
+  static std::unordered_map<std::string, uint32_t> counts;
+  std::lock_guard<std::mutex> lock(mutex);
+  return ++counts[key] <= limit;
+}
+
+// Guest IPv4 value as read through be<uint32_t> (first octet in the top byte).
+inline std::string NetAddr(uint32_t addr, uint32_t port) {
+  return fmt::format("{}.{}.{}.{}:{}", addr >> 24, (addr >> 16) & 0xFF, (addr >> 8) & 0xFF,
+                     addr & 0xFF, port);
+}
+
+}  // namespace rex::system::ao4
