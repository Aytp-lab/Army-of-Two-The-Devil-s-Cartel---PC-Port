+void Ao4StartNetStats() {
+  static std::once_flag once;
+  std::call_once(once, [] {
+    std::thread([] {
+      uint64_t sent = 0, sent_bytes = 0, received = 0, received_bytes = 0;
+      uint64_t buckets[6] = {}, repost_sum = 0, repost_count = 0, sync = 0, polls = 0, polls_done = 0;
+      uint64_t wake_sum = 0, wake_count = 0, process_sum = 0, process_count = 0;
+      for (;;) {
+        std::this_thread::sleep_for(std::chrono::seconds(5));
+        auto& s = g_net_stats;
+        const uint64_t now_sent = s.sent, now_sent_bytes = s.sent_bytes;
+        const uint64_t now_received = s.received, now_received_bytes = s.received_bytes;
+        REXLOG_WARN(
+            "AO4_NET_STATS 5s sent={} ({} B) recv={} ({} B) recv_failed={} recv_retried={} send_errors={} "
+            "max_backlog={} B max_repost_ms={:.1f}",
+            now_sent - sent, now_sent_bytes - sent_bytes, now_received - received,
+            now_received_bytes - received_bytes, uint64_t(s.recv_failed), uint64_t(s.recv_retried),
+            uint64_t(s.send_errors), s.max_backlog.exchange(0), s.max_repost_us.exchange(0) / 1000.0);
+        uint64_t now_buckets[6], hist[6];
+        for (int i = 0; i < 6; ++i) {
+          now_buckets[i] = s.repost_bucket[i];
+          hist[i] = now_buckets[i] - buckets[i];
+          buckets[i] = now_buckets[i];
+        }
+        const uint64_t now_sum = s.repost_sum_us, now_count = s.repost_count, now_sync = s.sync_completions;
+        const uint64_t count = now_count - repost_count;
+        const uint64_t now_polls = s.poll_calls, now_polls_done = s.poll_done;
+        REXLOG_WARN("AO4_NET_REPOST 5s count={} avg_ms={:.1f} sync={} polls={} polls_done={} "
+                    "hist<2/<10/<25/<50/<100/>=100ms={}/{}/{}/{}/{}/{}",
+                    count, count ? (now_sum - repost_sum) / 1000.0 / count : 0.0, now_sync - sync,
+                    now_polls - polls, now_polls_done - polls_done, hist[0], hist[1], hist[2], hist[3], hist[4],
+                    hist[5]);
+        polls = now_polls;
+        polls_done = now_polls_done;
+        const uint64_t ws = s.wake_sum_us, wc = s.wake_count, ps = s.process_sum_us, pc = s.process_count;
+        REXLOG_WARN("AO4_NET_LATENCY 5s wake avg_ms={:.1f} max_ms={:.1f} n={} | process avg_ms={:.1f} max_ms={:.1f} n={}",
+                    wc - wake_count ? (ws - wake_sum) / 1000.0 / (wc - wake_count) : 0.0,
+                    s.wake_max_us.exchange(0) / 1000.0, wc - wake_count,
+                    pc - process_count ? (ps - process_sum) / 1000.0 / (pc - process_count) : 0.0,
+                    s.process_max_us.exchange(0) / 1000.0, pc - process_count);
+        wake_sum = ws; wake_count = wc; process_sum = ps; process_count = pc;
+        repost_sum = now_sum;
+        repost_count = now_count;
+        sync = now_sync;
+        sent = now_sent;
+        sent_bytes = now_sent_bytes;
+        received = now_received;
+        received_bytes = now_received_bytes;
+      }
+    }).detach();
+  });
+}
+
+void Ao4NoteDatagramSent(int result, uint32_t length) {
+  if (!REX_KERNEL_STATE()->user_profile()->online_signin()) return;
+  Ao4StartNetStats();
+  if (result < 0) {
+    ++g_net_stats.send_errors;
+  } else {
+    ++g_net_stats.sent;
+    g_net_stats.sent_bytes += length;
+  }
+}
