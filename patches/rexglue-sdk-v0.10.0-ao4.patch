+bool D3D12CommandProcessor::InitializeMemexportWriteMask() {
+  auto& provider = GetD3D12Provider();
+  auto* device = provider.GetDevice();
+  D3D12_RESOURCE_DESC desc;
+  ui::d3d12::util::FillBufferResourceDesc(desc, memexport::kMaskSize, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+  memexport_write_mask_state_ = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+      D3D12_HEAP_FLAG_NONE, &desc, memexport_write_mask_state_, nullptr, IID_PPV_ARGS(&memexport_write_mask_)))) return false;
+  desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesUpload,
+      D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_GENERIC_READ, nullptr, IID_PPV_ARGS(&memexport_write_mask_zero_)))) return false;
+  D3D12_RANGE read_range = {0, 0};
+  void* mapping = nullptr;
+  if (FAILED(memexport_write_mask_zero_->Map(0, &read_range, &mapping))) return false;
+  std::memset(mapping, 0, memexport::kMaskSize);
+  D3D12_RANGE write_range = {0, memexport::kMaskSize};
+  memexport_write_mask_zero_->Unmap(0, &write_range);
+  return true;
+}
+
+bool D3D12CommandProcessor::PrepareMemexportWriteMask() {
+  PushTransitionBarrier(memexport_write_mask_, memexport_write_mask_state_, D3D12_RESOURCE_STATE_COPY_DEST);
+  memexport_write_mask_state_ = D3D12_RESOURCE_STATE_COPY_DEST;
+  SubmitBarriers();
+  if (memexport_ranges_.empty()) {
+    deferred_command_list_.D3DCopyBufferRegion(memexport_write_mask_, 0, memexport_write_mask_zero_, 0, memexport::kMaskSize);
+  } else {
+    for (const auto& range : memexport_ranges_) {
+      memexport::MaskRange mask;
+      if (!memexport::GetMaskRange(range.base_address_dwords << 2, range.size_bytes, mask)) return false;
+      if (mask.size) deferred_command_list_.D3DCopyBufferRegion(memexport_write_mask_, mask.offset, memexport_write_mask_zero_, mask.offset, mask.size);
+    }
+  }
+  PushTransitionBarrier(memexport_write_mask_, memexport_write_mask_state_, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  memexport_write_mask_state_ = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  SubmitBarriers();
+  return true;
+}
