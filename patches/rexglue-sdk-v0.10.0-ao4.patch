diff --git a/include/rex/graphics/memexport_write_mask.h b/include/rex/graphics/memexport_write_mask.h
new file mode 100644
index 0000000..96da894
--- /dev/null
+++ b/include/rex/graphics/memexport_write_mask.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace rex::graphics::memexport {
+// One bit per physical guest byte, including sub-dword shader exports.
+constexpr uint32_t kPhysicalSize = 0x20000000;
+constexpr uint32_t kMaskSize = kPhysicalSize / 8;
+struct MaskRange {
+  uint32_t offset;
+  uint32_t size;
+};
+inline bool GetMaskRange(uint32_t address, uint32_t size, MaskRange& result) {
+  if (uint64_t(address) + size > kPhysicalSize) return false;
+  const uint32_t begin = address / 32;
+  const uint32_t end = uint32_t((uint64_t(address) + size + 31) / 32);
+  result = {begin * 4, (end - begin) * 4};
+  return true;
+}
+// The mask describes executed stores, not changes in values. Unwritten guest
+// bytes retain any CPU updates made since the GPU buffer was uploaded.
+inline size_t CopyWrittenBytes(uint8_t* destination, const uint8_t* data,
+                               const uint8_t* mask, uint32_t mask_offset,
+                               uint32_t physical_address, uint32_t size) {
+  size_t copied = 0;
+  uint32_t index = 0;
+  while (index < size) {
+    const auto written = [&](uint32_t i) {
+      const uint32_t address = physical_address + i;
+      return (mask[(address >> 3) - mask_offset] >> (address & 7)) & 1;
+    };
+    if (!written(index)) { ++index; continue; }
+    const uint32_t begin = index++;
+    while (index < size && written(index)) ++index;
+    std::memcpy(destination + begin, data + begin, index - begin);
+    copied += index - begin;
+  }
+  return copied;
+}
+}  // namespace rex::graphics::memexport
