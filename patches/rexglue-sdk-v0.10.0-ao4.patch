+struct Ao4MemexportStats {
+  uint32_t draws = 0, sync_draws = 0, applied = 0, applied_nowait = 0, resolves = 0;
+  uint32_t syncs[14] = {};
+  double wait_ms = 0;
+  ULONGLONG last = 0;
