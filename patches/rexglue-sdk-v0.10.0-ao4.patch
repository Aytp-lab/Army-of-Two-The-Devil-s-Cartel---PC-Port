+    }
+    if(!s.report||now-s.report>=5000000){
+      if(LogAllowed())REXLOG_WARN("AO4_INPUT_POLL user={} caller={:08X} calls={} errors={} changes={} same_packet_changes={} max_gap_us={} max_query_us={} max_refresh_us={} result={}",
+        user_,caller_,s.calls,s.errors,s.changes,s.packet_stalls,s.max_gap,s.max_query,s.max_refresh,result);
