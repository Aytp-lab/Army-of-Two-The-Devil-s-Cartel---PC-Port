+class XlspServerEnumerator : public XStaticUntypedEnumerator {
+ public:
+  XlspServerEnumerator(KernelState* kernel_state, uint32_t items, uint32_t server, uint32_t extra_size)
+      : XStaticUntypedEnumerator(kernel_state, items, 208), server_(server), extra_size_(extra_size) {}
