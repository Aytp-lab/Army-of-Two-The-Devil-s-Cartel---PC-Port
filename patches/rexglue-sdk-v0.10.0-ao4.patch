diff --git a/include/rex/audio/frame_origin.h b/include/rex/audio/frame_origin.h
new file mode 100644
index 0000000..57e1ef4
--- /dev/null
+++ b/include/rex/audio/frame_origin.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// Observation only: one interleaved record holds the same queued frame's six
+// planar guest BE channels and the two actual LE values sent to SDL. This is
+// NOT a speaker layout and is never sent to an audio device.
+namespace ao4 {
+struct FrameParameters {
+  bool muted=false;
+  float gain=1,center=0,surround=0,lfe=0,scale=1;
+};
+inline void PackFrameOrigin(float* record,const float* guest_be,
+                            const float* submitted_stereo,size_t frames) noexcept {
+  for(size_t i=0;i<frames;++i){
+    for(size_t ch=0;ch<6;++ch){
+      uint32_t bits=0;
+      if(guest_be){
+        const auto* p=reinterpret_cast<const unsigned char*>(guest_be+ch*frames+i);
+        bits=(uint32_t(p[0])<<24)|(uint32_t(p[1])<<16)|(uint32_t(p[2])<<8)|uint32_t(p[3]);
+      }
+      std::memcpy(record+i*8+ch,&bits,sizeof(bits));
+    }
+    std::memcpy(record+i*8+6,submitted_stereo+i*2,2*sizeof(float));
+  }
+}
+}
