+#pragma once
+#include <cstdlib>
+#include <cstdint>
+#include "../../../../../native/diagnostics/query_trace_gate.h"
+
+inline void Ao4QueryDetail(uint64_t frame,const char* event,uint32_t address,
+                           uint64_t samples,uint64_t submission,uint64_t begin=0) {
+  uint64_t window=0;
+  if(!ao4_query_trace::Active(window)) return;
+  const uint64_t end=ao4_query_trace::Tick();
+  REXLOG_INFO("AO4_QUERY_GPU window={} qpc0={} qpc1={} freq={} frame={} event={} address={:08X} samples={} submission={}",
+      window,begin ? begin : end,end,ao4_query_trace::Frequency(),frame,event,address,samples,submission);
+}
+
+enum class Ao4OccEvent : unsigned {
+  Init, BypassDisabled, BypassUnavailable, Fallback, BeginMismatch,
+  EndMismatch, Begin, ResultZero, ResultVisible, EndFailure,
+  SubmissionCut, Disabled, Count
+};
+// GPU-thread-only observation. No query result, state or submission is changed.
+inline void Ao4TraceOcclusion(uint64_t frame,Ao4OccEvent event,
+                             uint32_t address=0,uint64_t samples=0) {
+  static const bool enabled=std::getenv("AO4_OCCLUSION_TRACE")!=nullptr;
+  if(!enabled) return;
+  static constexpr const char* names[]={"init","bypass-disabled","bypass-unavailable",
+    "fallback","begin-mismatch","end-mismatch","begin","host-zero",
+    "host-visible","end-failure","submission-cut","disabled"};
+  static uint64_t counts[unsigned(Ao4OccEvent::Count)]={};
+  static uint64_t last[unsigned(Ao4OccEvent::Count)]={};
+  const unsigned i=unsigned(event);
+  const uint64_t count=++counts[i];
+  if(count<=4 || frame-last[i]>=300) {
+    last[i]=frame;
+    REXLOG_INFO("AO4_OCCLUSION frame={} event={} count={} address={:08X} samples={}",
+                frame,names[i],count,address,samples);
+  }
+}
diff --git a/src/graphics/d3d12/ao4_texture_copy_probe.h b/src/graphics/d3d12/ao4_texture_copy_probe.h
new file mode 100644
index 0000000..12617f6
--- /dev/null
+++ b/src/graphics/d3d12/ao4_texture_copy_probe.h
@@ -0,0 +1,113 @@
+#pragma once
+// Opt-in, bounded capture of the known bad decal's physical page. No guest
+// writes, extra GPU waits, or altered copy/mask decisions.
+#include <windows.h>
+#include <array>
+#include <cstring>
+#include <cwchar>
+#include <rex/logging.h>
+
+namespace rex::graphics::d3d12 {
+struct Ao4TextureCopyProbe {
+  std::array<uint8_t, 4096> before{}, source{};
+  std::array<uint8_t, 512> mask{};
+  uint32_t target = 0, range_address = 0, range_size = 0;
+  bool valid = false;
+  const uint8_t* descriptor = nullptr;
+  uint32_t descriptor_before = 0;
+  bool descriptor_readable_before = false;
+  inline static unsigned reported = 0;
+  static uint64_t Hash(const uint8_t* bytes) {
+    uint64_t hash = 14695981039346656037ull;
+    for (unsigned i=0;i<4096;++i) hash=(hash^bytes[i])*1099511628211ull;
+    return hash;
+  }
+  static uint32_t Target() {
+    wchar_t value[16]{};
+    if (!GetEnvironmentVariableW(L"AO4_TEXTURE_COPY_TARGET",value,16)) return 0;
+    wchar_t* end=nullptr;
+    const auto target=wcstoul(value,&end,16);
+    return end && !*end && target && target<=0x1FFFF000 && !(target&4095)
+        ? uint32_t(target) : 0;
+  }
+  static uint32_t Descriptor() {
+    wchar_t value[16]{};
+    if (!GetEnvironmentVariableW(L"AO4_TEXTURE_COPY_DESCRIPTOR",value,16)) return 0;
+    wchar_t* end=nullptr;const auto result=wcstoul(value,&end,16);
+    return end && !*end ? uint32_t(result) : 0;
+  }
+  static bool ReadDescriptor(const uint8_t* bytes, uint32_t& result) {
+    if (!bytes) return false;
+    MEMORY_BASIC_INFORMATION info{};
+    if (!VirtualQuery(bytes,&info,sizeof(info)) || info.State!=MEM_COMMIT ||
+        (info.Protect&(PAGE_NOACCESS|PAGE_GUARD)) ||
+        uintptr_t(bytes)+4>uintptr_t(info.BaseAddress)+info.RegionSize) return false;
+    __try {
+      result=((uint32_t(bytes[0])<<24)|(uint32_t(bytes[1])<<16)|
+              (uint32_t(bytes[2])<<8)|bytes[3])&0x1FFFF000;
+      return true;
+    } __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+  }
+  void Prepare(uint8_t* physical_base, uint32_t address, uint32_t size,
+               const uint8_t* data, const uint8_t* written, uint32_t mask_offset,
+               const uint8_t* descriptor_bytes = nullptr) {
+    static const bool enabled=GetEnvironmentVariableW(L"AO4_TEXTURE_COPY_TRACE",nullptr,0)!=0;
+    if (!enabled || reported>=64) return;
+    target=Target();
+    if (!target || target<address || uint64_t(target)+4096>uint64_t(address)+size) return;
+    auto* page=physical_base+target;
+    MEMORY_BASIC_INFORMATION info{};
+    if (!VirtualQuery(page,&info,sizeof(info)) || info.State!=MEM_COMMIT ||
+        (info.Protect&(PAGE_NOACCESS|PAGE_GUARD)) ||
+        uintptr_t(page)+4096>uintptr_t(info.BaseAddress)+info.RegionSize) return;
+    std::memcpy(before.data(),page,4096);
+    std::memcpy(source.data(),data+(target-address),4096);
+    std::memcpy(mask.data(),written+((target>>3)-mask_offset),512);
+    range_address=address;range_size=size;valid=true;
+    descriptor=descriptor_bytes;
+    descriptor_readable_before=ReadDescriptor(descriptor,descriptor_before);
+  }
+  void Finish(uint8_t* physical_base, uint64_t frame) {
+    if (!valid) return;
+    if (reported>=64) return;
+    std::array<uint8_t,4096> after{};
+    std::memcpy(after.data(),physical_base+target,4096);
+    const auto before_hash=Hash(before.data()),source_hash=Hash(source.data()),after_hash=Hash(after.data());
+    if (reported>=4 && before_hash==source_hash && before_hash==after_hash) return;
+    const auto sequence=++reported;
+    unsigned marked=0,mismatched=0,changed=0;
+    for (unsigned i=0;i<4096;++i) {
+      const bool write=(mask[i>>3]>>(i&7))&1;
+      marked+=write;changed+=before[i]!=after[i];
+      mismatched+=after[i]!=(write?source[i]:before[i]);
+    }
+    const bool target_stable=Target()==target;
+    uint32_t descriptor_after=0;
+    const bool descriptor_readable_after=ReadDescriptor(descriptor,descriptor_after);
+    REXGPU_INFO("AO4_TEXTURE_COPY seq={} frame={} physical={:08X} range={:08X}+{} "
+                "target_stable={} marked={} changed={} after_vs_mask_mismatch={} "
+                "before={:016X} source={:016X} after={:016X}",
+                sequence,frame,target,range_address,range_size,target_stable,
+                marked,changed,mismatched,before_hash,source_hash,after_hash);
+    REXGPU_INFO("AO4_TEXTURE_COPY_OWNER seq={} before_readable={} before={:08X} "
+                "after_readable={} after={:08X} owned_before={} owned_after={}",
+                sequence,descriptor_readable_before,descriptor_before,
+                descriptor_readable_after,descriptor_after,
+                descriptor_readable_before && descriptor_before==target,
+                descriptor_readable_after && descriptor_after==target);
+    wchar_t directory[MAX_PATH]{},path[MAX_PATH+80]{};
+    const auto length=GetEnvironmentVariableW(L"AO4_AV_CAPTURE_DIR",directory,MAX_PATH);
+    if (!length || length>=MAX_PATH) return;
+    swprintf_s(path,L"%ls/texture-copy-%04u-%08X.bin",directory,sequence,target);
+    const auto file=CreateFileW(path,GENERIC_WRITE,FILE_SHARE_READ,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,nullptr);
+    if (file==INVALID_HANDLE_VALUE) return;
+    DWORD count=0;
+    const bool saved=WriteFile(file,before.data(),4096,&count,nullptr)&&count==4096 &&
+        WriteFile(file,source.data(),4096,&count,nullptr)&&count==4096 &&
+        WriteFile(file,after.data(),4096,&count,nullptr)&&count==4096 &&
+        WriteFile(file,mask.data(),512,&count,nullptr)&&count==512;
+    CloseHandle(file);
+    REXGPU_INFO("AO4_TEXTURE_COPY_FILE seq={} saved={} layout=before4096,source4096,after4096,mask512",sequence,saved);
+  }
+};
+} // namespace rex::graphics::d3d12
diff --git a/src/graphics/d3d12/ao4_validation_log.h b/src/graphics/d3d12/ao4_validation_log.h
new file mode 100644
index 0000000..5eea58b
--- /dev/null
+++ b/src/graphics/d3d12/ao4_validation_log.h
@@ -0,0 +1,63 @@
+#pragma once
+#include <atomic>
+#include <cstdlib>
+#include <vector>
+
+inline bool& Ao4ValidationPollRequired() { static bool value=false; return value; }
+
+// GPU-plugin-only observer; the existing audio/runtime DLL remains unchanged.
+// The normal runtime --d3d12_debug flag enables the layer before device creation.
+inline void Ao4RegisterD3D12ValidationLog(ID3D12Device* device) {
+  if (!std::getenv("AO4_D3D12_VALIDATION_LOG")) return;
+  Microsoft::WRL::ComPtr<ID3D12InfoQueue1> queue;
+  if (FAILED(device->QueryInterface(IID_PPV_ARGS(&queue)))) {
+    Microsoft::WRL::ComPtr<ID3D12InfoQueue> fallback;
+    const HRESULT hr=device->QueryInterface(IID_PPV_ARGS(&fallback));
+    Ao4ValidationPollRequired()=SUCCEEDED(hr);
+    REXLOG_INFO("AO4_D3D12_VALIDATION callback_interface=unavailable polling_queue_hresult={:08X}", uint32_t(hr));
+    return;
+  }
+  DWORD cookie = 0;
+  const HRESULT result = queue->RegisterMessageCallback(
+      [](D3D12_MESSAGE_CATEGORY category, D3D12_MESSAGE_SEVERITY severity,
+         D3D12_MESSAGE_ID id, LPCSTR description, void*) {
+        if (severity > D3D12_MESSAGE_SEVERITY_WARNING) return;
+        static std::atomic<unsigned> counts[3]{};
+        const unsigned index = unsigned(severity);
+        const unsigned count = counts[index].fetch_add(1, std::memory_order_relaxed);
+        if (count < 128) {
+          REXLOG_WARN("AO4_D3D12_MESSAGE category={} severity={} id={} description={}",
+                      unsigned(category), index, unsigned(id), description);
+        } else if (count == 128) {
+          REXLOG_WARN("AO4_D3D12_MESSAGE severity={} limit=128 further_messages_not_logged", index);
+        }
+      }, D3D12_MESSAGE_CALLBACK_FLAG_NONE, nullptr, &cookie);
+  REXLOG_INFO("AO4_D3D12_VALIDATION message_callback_hresult={:08X} gpu_based_validation=not_requested",
+              uint32_t(result));
+}
+
+inline void Ao4PollD3D12ValidationLog(ID3D12Device* device) {
+  if (!Ao4ValidationPollRequired()) return;
+  Microsoft::WRL::ComPtr<ID3D12InfoQueue> queue;
+  if (FAILED(device->QueryInterface(IID_PPV_ARGS(&queue)))) return;
+  static UINT64 next=0;
+  static unsigned counts[3]={};
+  const UINT64 total=queue->GetNumStoredMessagesAllowedByRetrievalFilter();
+  if (total<next) next=0;
+  unsigned work=0;
+  while (next<total && work++<64) {
+    SIZE_T size=0;
+    const UINT64 index=next++;
+    if (FAILED(queue->GetMessage(index,nullptr,&size)) || size>65536) continue;
+    std::vector<uint8_t> storage(size);
+    auto* message=reinterpret_cast<D3D12_MESSAGE*>(storage.data());
+    if (FAILED(queue->GetMessage(index,message,&size)) ||
+        message->Severity>D3D12_MESSAGE_SEVERITY_WARNING) continue;
+    const unsigned severity=unsigned(message->Severity);
+    if (counts[severity]++<128)
+      REXLOG_WARN("AO4_D3D12_MESSAGE category={} severity={} id={} description={}",
+                  unsigned(message->Category),severity,unsigned(message->ID),message->pDescription);
+    else if (counts[severity]==129)
+      REXLOG_WARN("AO4_D3D12_MESSAGE severity={} limit=128 further_messages_not_logged",severity);
+  }
+}
