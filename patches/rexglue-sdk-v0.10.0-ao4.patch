+// Overlapped WSARecvFrom: the datagram is received on a helper thread, scattered into the
+// guest buffers, and the WSAOVERLAPPED completed (Internal = status, InternalHigh = bytes).
+namespace {
+constexpr uint32_t kStatusPending = 0x103;
+
+struct PendingRecv {
+  object_ref<XSocket> socket;
+  std::vector<std::pair<uint32_t, uint32_t>> buffers;  // guest address, length
+  uint32_t from_addr = 0, from_len = 0, overlapped = 0, bytes_ptr = 0, flags_ptr = 0;
+  bool async = false;  // completed later by the helper thread
+};
+
+bool ReceiveInto(PendingRecv& job, uint32_t& received, uint32_t& error) {
+  uint32_t capacity = 0;
+  for (auto& b : job.buffers) capacity += b.second;
+  std::vector<uint8_t> data(std::max<uint32_t>(capacity, 1));
+  N_XSOCKADDR_IN from;
+  uint32_t from_len = sizeof(N_XSOCKADDR_IN);
+  const int ret = job.socket->RecvFrom(data.data(), capacity, 0, &from, &from_len);
+  if (ret < 0) {
+#if REX_PLATFORM_WIN32
+    error = WSAGetLastError();
+#else
+    error = 0x2726;
+#endif
+    return false;
+  }
+  received = uint32_t(ret);
+  ++g_net_stats.received;
+  g_net_stats.received_bytes += received;
+#if REX_PLATFORM_WIN32
+  u_long backlog = 0;
+  if (ioctlsocket(job.socket->native_handle(), FIONREAD, &backlog) == 0) {
+    Ao4AtomicMax(g_net_stats.max_backlog, uint32_t(backlog));
+  }
+#endif
+  g_net_stats.last_complete_us = Ao4NowUs();
+  uint32_t offset = 0;
+  for (auto& b : job.buffers) {
+    const uint32_t chunk = std::min(b.second, received - offset);
+    if (!chunk) break;
+    std::memcpy(REX_KERNEL_MEMORY()->TranslateVirtual(b.first), data.data() + offset, chunk);
+    offset += chunk;
+  }
+  if (job.from_addr) {
+    auto* guest_from = REX_KERNEL_MEMORY()->TranslateVirtual<XSOCKADDR_IN*>(job.from_addr);
+    guest_from->sin_family = from.sin_family;
+    guest_from->sin_port = from.sin_port;
+    guest_from->sin_addr = from.sin_addr;
+    std::memset(guest_from->x_sin_zero, 0, sizeof(guest_from->x_sin_zero));
+    if (job.from_len) memory::store_and_swap<uint32_t>(REX_KERNEL_MEMORY()->TranslateVirtual(job.from_len), 16);
+  }
+  return true;
+}
+
+void CompleteRecv(PendingRecv& job, uint32_t status, uint32_t received) {
+  auto* overlapped = REX_KERNEL_MEMORY()->TranslateVirtual<XWSAOVERLAPPED*>(job.overlapped);
+  if (NetTrace() && NetTraceBudget("RecvComplete", 64)) {
+    REXLOG_WARN("AO4_NET recv-complete {} ov={:08X} status={:08X} bytes={} event={:08X}", job.async ? "async" : "sync",
+                job.overlapped, status,
+                received, uint32_t(overlapped->event_handle));
+  }
+  overlapped->internal_high = received;
+  overlapped->internal = status;
+  // Like WinSock/XNet, lpNumberOfBytesRecvd and lpFlags are only written when the receive completes
+  // immediately; a later completion is reported through WSAGetOverlappedResult alone. DirtySock passes
+  // its 'packet waiting' field here and sets it to -1 while pending: writing it on an asynchronous
+  // completion made its receive thread skip the poll (~100 ms) and deliver the datagram twice.
+  if (!job.async) {
+    if (job.bytes_ptr) memory::store_and_swap<uint32_t>(REX_KERNEL_MEMORY()->TranslateVirtual(job.bytes_ptr), received);
+    if (job.flags_ptr) memory::store_and_swap<uint32_t>(REX_KERNEL_MEMORY()->TranslateVirtual(job.flags_ptr), 0);
+  }
+  if (const uint32_t event = overlapped->event_handle) {
+    if (auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event)) ev->Set(0, false);
+  }
+}
+
+bool Readable(XSocket* socket, int timeout_ms) {
+  fd_set reads;
+  FD_ZERO(&reads);
+  FD_SET(socket->native_handle(), &reads);
+  timeval timeout = {timeout_ms / 1000, (timeout_ms % 1000) * 1000};
+  return select(int(socket->native_handle() + 1), &reads, nullptr, nullptr, &timeout) > 0;
+}
+}  // namespace
+
+u32 Ao4_WSARecvFrom_overlapped(u32 socket_handle, ppc_ptr_t<XWSABUF> buffers_ptr, u32 buffer_count,
+                               mapped_u32 num_bytes_recv, mapped_u32 flags_ptr,
+                               ppc_ptr_t<XSOCKADDR_IN> from_addr, mapped_u32 from_len,
+                               ppc_ptr_t<XWSAOVERLAPPED> overlapped_ptr) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    XThread::SetLastError(0x2736);  // WSAENOTSOCK
+    return ~0u;
+  }
+  Ao4StartNetStats();
+  if (const int64_t seen = g_net_stats.seen_us.exchange(0)) {
+    const int64_t now = Ao4NowUs();
+    g_net_stats.process_sum_us += uint64_t(now - seen);
+    ++g_net_stats.process_count;
+    Ao4AtomicMax(g_net_stats.process_max_us, uint32_t(std::min<int64_t>(now - seen, UINT32_MAX)));
+  }
+  if (const int64_t last = g_net_stats.last_complete_us.exchange(0)) {
+    const int64_t delay = Ao4NowUs() - last;
+    Ao4AtomicMax(g_net_stats.max_repost_us, uint32_t(std::min<int64_t>(delay, UINT32_MAX)));
+    const int bucket = delay < 2000 ? 0 : delay < 10000 ? 1 : delay < 25000 ? 2 : delay < 50000 ? 3 : delay < 100000 ? 4 : 5;
+    ++g_net_stats.repost_bucket[bucket];
+    g_net_stats.repost_sum_us += uint64_t(delay);
+    ++g_net_stats.repost_count;
+  }
+  auto job = std::make_shared<PendingRecv>();
+  job->socket = socket;
+  for (uint32_t i = 0; i < buffer_count; ++i) job->buffers.emplace_back(buffers_ptr[i].buf_ptr, buffers_ptr[i].len);
+  job->from_addr = from_addr.guest_address();
+  job->from_len = from_len.guest_address();
+  job->overlapped = overlapped_ptr.guest_address();
+  job->bytes_ptr = num_bytes_recv.guest_address();
+  job->flags_ptr = flags_ptr.guest_address();
+
+  uint32_t received = 0, error = 0;
+  if (Readable(socket.get(), 0)) {
+    if (ReceiveInto(*job, received, error)) {
+      ++g_net_stats.sync_completions;
+      CompleteRecv(*job, 0, received);
+      return 0;
+    }
+    if (error != 10054 && error != 10035) {
+      ++g_net_stats.recv_failed;
+      XThread::SetLastError(error);
+      return ~0u;
+    }
+    ++g_net_stats.recv_retried;  // nothing to read after all: continue as a pending receive
+  }
+  overlapped_ptr->internal = kStatusPending;
+  overlapped_ptr->internal_high = 0;
+  std::thread([job]() {
+    job->async = true;
+    for (;;) {
+      if (Readable(job->socket.get(), 100)) {
+        uint32_t received = 0, error = 0;
+        if (ReceiveInto(*job, received, error)) {
+          g_net_stats.async_complete_us = Ao4NowUs();
+          CompleteRecv(*job, 0, received);
+          return;
+        }
+        // WSAECONNRESET (ICMP port unreachable) is not fatal for datagram sockets. WSAEWOULDBLOCK:
+        // another reader took the datagram after select; keep waiting instead of failing the I/O.
+        if (error == 10054 || error == 10035) {
+          ++g_net_stats.recv_retried;
+          continue;
+        }
+        ++g_net_stats.recv_failed;
+        CompleteRecv(*job, 0xC0000001, 0);  // STATUS_UNSUCCESSFUL
+        return;
+      }
+      // A closed socket makes select fail; the overlapped stays pending like a cancelled one.
+      fd_set probe;
+      FD_ZERO(&probe);
+      FD_SET(job->socket->native_handle(), &probe);
+      timeval zero = {0, 0};
+      if (select(int(job->socket->native_handle() + 1), &probe, nullptr, nullptr, &zero) < 0) {
+        CompleteRecv(*job, 0xC0000120, 0);  // STATUS_CANCELLED
+        return;
+      }
+    }
+  }).detach();
+  XThread::SetLastError(997);  // WSA_IO_PENDING
+  return ~0u;
+}
+
+// WSAGetOverlappedResult(s, lpOverlapped, lpcbTransfer, fWait, lpdwFlags) -> BOOL.
+u32 NetDll_WSAGetOverlappedResult_entry(u32 caller, u32 socket_handle,
+                                        ppc_ptr_t<XWSAOVERLAPPED> overlapped, mapped_u32 transferred,
+                                        u32 wait, mapped_u32 flags) {
+  if (!overlapped) {
+    XThread::SetLastError(0x271E);  // WSAEFAULT
+    return 0;
+  }
+  while (wait && uint32_t(overlapped->internal) == kStatusPending) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+  const uint32_t status = overlapped->internal;
+  ++g_net_stats.poll_calls;
+  if (status != kStatusPending) {
+    ++g_net_stats.poll_done;
+    if (const int64_t done = g_net_stats.async_complete_us.exchange(0)) {
+      const int64_t now = Ao4NowUs();
+      g_net_stats.wake_sum_us += uint64_t(now - done);
+      ++g_net_stats.wake_count;
+      Ao4AtomicMax(g_net_stats.wake_max_us, uint32_t(std::min<int64_t>(now - done, UINT32_MAX)));
+      g_net_stats.seen_us = now;
+    }
+  }
+  if (NetTrace() && status != kStatusPending && NetTraceBudget("WSAGetOverlappedResult done", 64)) {
+    REXLOG_WARN("AO4_NET WSAGetOverlappedResult {:08X} ov={:08X} wait={} -> status={:08X} bytes={}",
+                uint32_t(socket_handle), overlapped.guest_address(), uint32_t(wait), status,
+                uint32_t(overlapped->internal_high));
+  }
+  if (status == kStatusPending) {
+    XThread::SetLastError(996);  // WSA_IO_INCOMPLETE
+    return 0;
+  }
+  if (transferred) *transferred = overlapped->internal_high;
+  if (flags) *flags = 0;
+  if (status != 0) {
+    XThread::SetLastError(status == 0xC0000120 ? 995 : 0x2746);  // WSA_OPERATION_ABORTED / WSAECONNRESET
+    return 0;
+  }
+  return 1;
+}
+
+u32 Ao4XnAddrToInAddr(const XNADDR* xnaddr, uint8_t* in_addr) {
+  if (!xnaddr || !in_addr) return X_ERROR_INVALID_PARAMETER;
+  RememberXnAddr(*xnaddr);
+  std::memcpy(in_addr, &xnaddr->ina.s_addr, 4);
+  return 0;
+}
+
+u32 Ao4InAddrToXnAddr(const uint8_t* in_addr, XNADDR* xnaddr) {
+  uint32_t key = 0;
+  std::memcpy(&key, in_addr, 4);
+  std::lock_guard<std::mutex> lock(g_xnaddr_mutex);
+  auto it = g_known_xnaddrs.find(key);
+  if (it != g_known_xnaddrs.end()) {
+    *xnaddr = it->second;
+  } else {
+    std::memset(xnaddr, 0, sizeof(XNADDR));
+    xnaddr->ina.s_addr = key;
+    xnaddr->inaOnline.s_addr = key;
+  }
+  return 0;
+}
