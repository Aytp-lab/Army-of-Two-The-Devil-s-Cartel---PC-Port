+std::filesystem::path EnvPath(const char* name) {
+#ifdef _WIN32
+  std::wstring key; for(const char* c=name;*c;++c)key+=wchar_t(*c);
+  const DWORD count=GetEnvironmentVariableW(key.c_str(),nullptr,0);
+  if(!count || count>32768)return {};
+  std::wstring value(count,L'\0');
+  const DWORD used=GetEnvironmentVariableW(key.c_str(),value.data(),count);
+  if(!used || used>=count)return {};
+  value.resize(used);return value;
+#else
+  const char* value=std::getenv(name);return value?std::filesystem::u8path(value):std::filesystem::path{};
+#endif
+}
+const char* Name(XmaLifeKind kind) {
+  switch(kind){
+    case XmaLifeKind::Initialize:return "initialize";
+    case XmaLifeKind::Clear:return "clear";
+    case XmaLifeKind::Release:return "release";
+    case XmaLifeKind::InputEnd:return "input_end";
+    case XmaLifeKind::FlushTail:return "flush_tail";
+    case XmaLifeKind::ReadOverwrite:return "read_overwrite";
+    case XmaLifeKind::SupersededWork:return "superseded_work";
+    case XmaLifeKind::DecodeFailure:return "decode_failure";
+    case XmaLifeKind::InputChangedDuringWork:return "input_changed_during_work";
+    case XmaLifeKind::BeforeInitialize:return "before_initialize";
+    case XmaLifeKind::RenderGet:return "render_get";
+    case XmaLifeKind::RenderRelease:return "render_release";
+    case XmaLifeKind::RenderZeroSubmit:return "render_zero_submit";
+    case XmaLifeKind::RenderProcess:return "render_process";
+    case XmaLifeKind::BeforeInitializeV2:return "before_initialize_v2";
+    case XmaLifeKind::Disable:return "disable";
+    case XmaLifeKind::InputBuffer0:return "input_buffer_0";
+    case XmaLifeKind::InputBuffer1:return "input_buffer_1";
+    case XmaLifeKind::InputValid0:return "input_valid_0";
+    case XmaLifeKind::InputValid1:return "input_valid_1";
+    case XmaLifeKind::TailContinue:return "tail_continue";
+    case XmaLifeKind::TailDeferred:return "tail_deferred";
+    case XmaLifeKind::TailDemand:return "tail_demand";
+    case XmaLifeKind::SampleRead:return "sample_read";
+    case XmaLifeKind::SampleReconfigure:return "sample_reconfigure";
+    case XmaLifeKind::SampleRetireCallback:return "sample_retire_callback";
+    case XmaLifeKind::SampleReleaseRequest:return "sample_release_request";
+    case XmaLifeKind::SampleSoundCreated:return "sample_sound_created";
+    case XmaLifeKind::SampleSoundStopRequest:return "sample_sound_stop_request";
+    case XmaLifeKind::SampleSoundDestroyQueued:return "sample_sound_destroy_queued";
+    case XmaLifeKind::SampleSoundDestroyExecute:return "sample_sound_destroy_execute";
