+  a_.OpULT(dxbc::Dest::R(temp, 4), dxbc::Src::R(temp, dxbc::Src::kWWWW), dxbc::Src::LU(size));
+  a_.OpIf(true, dxbc::Src::R(temp, dxbc::Src::kZZZZ));
+  a_.OpIAdd(dxbc::Dest::R(temp, 1), dxbc::Src::R(temp, dxbc::Src::kXXXX), dxbc::Src::LU(4));
