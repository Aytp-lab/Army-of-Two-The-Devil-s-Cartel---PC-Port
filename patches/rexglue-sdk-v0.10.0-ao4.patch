+void FillRandom(void* data, uint32_t length) {
+#if REX_PLATFORM_WIN32
+  BCryptGenRandom(nullptr, static_cast<PUCHAR>(data), length, BCRYPT_USE_SYSTEM_PREFERRED_RNG);
+#else
+  std::random_device random;
+  for (uint32_t i = 0; i < length; ++i) static_cast<uint8_t*>(data)[i] = uint8_t(random());
+#endif
+}
