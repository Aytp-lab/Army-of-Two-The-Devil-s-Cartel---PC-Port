+#pragma once
+#include <algorithm>
+#include <cstdint>
+namespace ao4 {
+// Counts guest swap boundaries. It never owns an externally started capture.
+class GuestCaptureSeries {
+  uint32_t remaining_ = 0;
+  bool owned_ = false;
+ public:
+  bool active() const { return remaining_ != 0; }
+  bool owned() const { return owned_; }
+  bool needs_start() const { return active() && !owned_; }
+  void request(uint32_t frames) {
+    if (!active()) remaining_ = (std::max)(1u, (std::min)(8u, frames));
+  }
+  void started(bool success) { owned_ = success; if (!success) remaining_ = 0; }
+  void finished(bool saved) {
+    if (!owned_) return;
+    owned_ = false;
+    if (saved) --remaining_; else remaining_ = 0;
+  }
+};
+}
