+// Fixed-point component widths of guest texture formats (0 = not fixed-point,
+// nothing to rescale), from Xenia Edge's FormatInfo table.
+bool GetFixedComponentBits(xenos::TextureFormat format, uint8_t bits[4]) {
+  auto set = [&](uint8_t r, uint8_t g, uint8_t b, uint8_t a) {
+    bits[0] = r;
+    bits[1] = g;
+    bits[2] = b;
+    bits[3] = a;
+    return true;
+  };
+  switch (format) {
+    case xenos::TextureFormat::k_8:
+    case xenos::TextureFormat::k_8_A:
+    case xenos::TextureFormat::k_8_B:
+    case xenos::TextureFormat::k_DXT3A:
+    case xenos::TextureFormat::k_DXT5A:
+      return set(8, 0, 0, 0);
+    case xenos::TextureFormat::k_1_5_5_5:
+      return set(5, 5, 5, 1);
+    case xenos::TextureFormat::k_5_6_5:
+      return set(5, 6, 5, 0);
+    case xenos::TextureFormat::k_6_5_5:
+      return set(5, 5, 6, 0);
+    case xenos::TextureFormat::k_8_8_8_8:
+    case xenos::TextureFormat::k_8_8_8_8_A:
+    case xenos::TextureFormat::k_8_8_8_8_AS_16_16_16_16:
+    case xenos::TextureFormat::k_8_8_8_8_GAMMA_EDRAM:
+      return set(8, 8, 8, 8);
+    case xenos::TextureFormat::k_2_10_10_10:
+    case xenos::TextureFormat::k_2_10_10_10_AS_16_16_16_16:
+      return set(10, 10, 10, 2);
+    case xenos::TextureFormat::k_8_8:
+    case xenos::TextureFormat::k_DXN:
+    case xenos::TextureFormat::k_CTX1:
+      return set(8, 8, 0, 0);
+    case xenos::TextureFormat::k_4_4_4_4:
+      return set(4, 4, 4, 4);
+    case xenos::TextureFormat::k_10_11_11:
+    case xenos::TextureFormat::k_10_11_11_AS_16_16_16_16:
+      return set(11, 11, 10, 0);
+    case xenos::TextureFormat::k_11_11_10:
+    case xenos::TextureFormat::k_11_11_10_AS_16_16_16_16:
+      return set(10, 11, 11, 0);
+    case xenos::TextureFormat::k_16:
+      return set(16, 0, 0, 0);
+    case xenos::TextureFormat::k_16_16:
+    case xenos::TextureFormat::k_16_16_EDRAM:
+      return set(16, 16, 0, 0);
+    case xenos::TextureFormat::k_16_16_16_16:
+    case xenos::TextureFormat::k_16_16_16_16_EDRAM:
+      return set(16, 16, 16, 16);
+    default:
+      return false;
+  }
+}
