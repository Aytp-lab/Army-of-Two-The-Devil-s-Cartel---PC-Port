+void D3D12CommandProcessor::PrepareForWait() {
+  // Includes WAIT_REG_MEM and the idle worker path. Never leave a guest
+  // completion marker pending while waiting for commands produced by that guest.
+  if (REXCVAR_GET(occlusion_query_publish_async)) {
+    // AO4: hand the outstanding work to the GPU and publish what has completed, without blocking:
+    // the idle loop / WAIT_REG_MEM loop keeps polling (OnIdlePoll / PrepareForWait), so new guest
+    // commands are not held up behind a full GPU wait.
+    if ((!ao4_memexport_pending_.empty() || !pending_occlusion_queries_.empty()) && submission_open_ &&
+        CanEndSubmissionImmediately()) {
+      EndSubmission(false);
+    }
+    OnIdlePoll();
+  } else {
+    if (!ao4_memexport_pending_.empty()) Ao4ApplyCompletedMemexports(true, 10);
+    if (!pending_occlusion_queries_.empty()) {
+      Ao4WaitTagScope tag(2);
+      CheckSubmissionFence(submission_current_);
+    }
+  }
+  CommandProcessor::PrepareForWait();
+}
