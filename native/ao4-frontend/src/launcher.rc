// Version info and manifest of AO4Launcher.exe.
#include <winres.h>

1 RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,1
 PRODUCTVERSION 0,1,0,1
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Army of Two: The Devil's Cartel native port launcher (fan project, no game data)"
      VALUE "FileVersion", "0.1.0-test1"
      VALUE "ProductName", "AO4 Native Port Launcher"
      VALUE "ProductVersion", "0.1.0-test1"
      VALUE "OriginalFilename", "AO4Launcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
